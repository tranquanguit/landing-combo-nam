---
import type { AnalyticsConfig } from '../lib/analytics';
import { t, type Locale } from '../i18n/ui';
import { safeJsonLd } from '../lib/richtext';

interface Props { locale: Locale; value: number; currency: string; itemId: string; itemName: string; }
const { locale, value, currency, itemId, itemName } = Astro.props;

const config: AnalyticsConfig = {
  ga4: import.meta.env.PUBLIC_GA4_ID || undefined,
  metaPixel: import.meta.env.PUBLIC_META_PIXEL_ID || undefined,
  tiktokPixel: import.meta.env.PUBLIC_TIKTOK_PIXEL_ID || undefined,
  /**
   * Hỏi đồng ý ở MỌI ngôn ngữ.
   *
   * Trước đây chỉ hỏi khi locale khác 'vi', với lý do "Việt Nam chưa yêu cầu
   * đồng ý trước". Sai ở hai điểm: Nghị định 13/2023/NĐ-CP có yêu cầu về sự
   * đồng ý khi xử lý dữ liệu cá nhân, và quan trọng hơn — ngôn ngữ trang không
   * cho biết người đọc đang ở đâu. Một người ở EU hoàn toàn có thể đọc bản
   * tiếng Việt, và khi đó họ bị đặt cookie đo lường mà chưa đồng ý.
   */
  requireConsent: true,
  currency, value, itemId, itemName,
};

const anyConfigured = !!(config.ga4 || config.metaPixel || config.tiktokPixel);
---
<script is:inline set:html={`window.__mochaAnalytics=${safeJsonLd(config)}`} />

{anyConfigured && config.requireConsent && (
  <div class="consent" id="consent-bar" role="region" aria-label={t(locale, 'consent.title')} hidden>
    <p>{t(locale, 'consent.body')}</p>
    <div class="consent-actions">
      <button type="button" id="consent-no" class="btn btn-ghost">{t(locale, 'consent.decline')}</button>
      <button type="button" id="consent-yes" class="btn btn-primary">{t(locale, 'consent.accept')}</button>
    </div>
  </div>
)}

<style>
  /* display:grid đè lên thuộc tính [hidden], nên phải nói rõ. */
  .consent[hidden] { display: none; }
  .consent {
    position: fixed; inset-inline: 0; z-index: 80;
    /* Đặt phía trên thanh CTA cố định, không đè lên nó: khách lần đầu trên
       điện thoại phải bấm được nút đặt hàng ngay cả khi chưa trả lời consent. */
    bottom: calc(64px + env(safe-area-inset-bottom));
    background: var(--paper); border-top: 1px solid var(--line);
    padding: var(--s-3) var(--s-4);
    font-size: var(--t-xs);
    /* Ở màn hình thấp, thanh từng chiếm tới 48% chiều cao và đè lên CTA của
       hero. Giới hạn chiều cao và cho phần chữ cuộn trong chính nó. */
    max-height: 40vh; overflow-y: auto;
    display: grid; gap: var(--s-3); font-size: var(--t-sm);
    box-shadow: 0 -8px 28px rgba(14, 18, 80, .12);
  }
  @media (min-width: 640px) {
    .consent { grid-template-columns: 1fr auto; align-items: center; }
  }
  @media (min-width: 900px) {
    /* Trên desktop không có thanh CTA cố định nên bám sát đáy màn hình. */
    .consent {
      grid-template-columns: 1fr auto; align-items: center;
      bottom: 0; padding-bottom: calc(var(--s-4) + env(safe-area-inset-bottom));
    }
  }
  .consent p { margin: 0; max-width: 70ch; }
  .consent-actions { display: flex; gap: var(--s-2); }
  .consent .btn { padding: 10px 18px; font-size: var(--t-sm); }
</style>

<script>
  const cfg = (window as any).__mochaAnalytics as {
    ga4?: string; metaPixel?: string; tiktokPixel?: string;
    requireConsent: boolean; currency: string; value: number; itemId: string; itemName: string;
  };
  const CONSENT_KEY = 'mocha_analytics_consent';

  /* GDPR điều 7(3): rút lại sự đồng ý phải dễ như khi cho. Hàm này được gắn
     vào link trong footer, và xoá luôn cookie mà pixel đã đặt. */
  /* Xoá hẳn quyết định để banner hỏi lại — dành cho người đã từ chối và muốn đổi ý. */
  (window as any).mochaResetConsent = () => {
    try { localStorage.removeItem(CONSENT_KEY); } catch { /* chế độ riêng tư */ }
    location.reload();
  };

  (window as any).mochaWithdrawConsent = () => {
    try { localStorage.setItem(CONSENT_KEY, 'no'); } catch { /* chế độ riêng tư */ }
    for (const c of document.cookie.split(';')) {
      const name = c.split('=')[0].trim();
      if (/^(_ga|_gid|_fbp|_fbc|_ttp|_tt_)/.test(name)) {
        document.cookie = `${name}=; Max-Age=0; path=/`;
        document.cookie = `${name}=; Max-Age=0; path=/; domain=.${location.hostname}`;
      }
    }
    location.reload();
  };

  /* Hàng đợi luôn hoạt động, kể cả khi không nạp pixel nào. Nhờ đó trang vẫn
     phát sự kiện cho mã khác lắng nghe, và không có nhánh code chết. */
  const queue: { name: string; params: Record<string, unknown> }[] = [];
  let loaded = false;

  const params = (extra: Record<string, unknown> = {}) => ({
    currency: cfg.currency, value: cfg.value,
    items: [{ item_id: cfg.itemId, item_name: cfg.itemName, price: cfg.value, quantity: 1 }],
    ...extra,
  });

  function forward(name: string, p: Record<string, unknown>) {
    const w = window as any;
    w.dataLayer = w.dataLayer || [];
    w.dataLayer.push({ event: name, ...p });
    if (typeof w.gtag === 'function') w.gtag('event', name, p);
    const std: Record<string, string> = {
      view_item: 'ViewContent', begin_checkout: 'InitiateCheckout', contact: 'Contact',
    };
    const fbName = std[name] ?? (name === 'generate_lead' ? 'Lead' : '');
    const ttName = std[name] ?? (name === 'generate_lead' ? 'SubmitForm' : '');
    if (typeof w.fbq === 'function' && fbName) w.fbq('track', fbName, p);
    if (w.ttq?.track && ttName) w.ttq.track(ttName, p);
  }

  function track(name: string, extra: Record<string, unknown> = {}) {
    const p = params(extra);
    window.dispatchEvent(new CustomEvent('mocha:event', { detail: { name, params: p } }));
    if (loaded) forward(name, p); else queue.push({ name, params: p });
  }
  (window as any).mochaTrack = track;

  function inject(src: string) {
    const s = document.createElement('script');
    s.async = true; s.src = src;
    document.head.appendChild(s);
  }

  function loadVendors() {
    if (loaded) return;
    loaded = true;
    const w = window as any;

    if (cfg.ga4) {
      w.dataLayer = w.dataLayer || [];
      w.gtag = function () { w.dataLayer.push(arguments); };
      w.gtag('js', new Date());
      w.gtag('config', cfg.ga4);
      inject(`https://www.googletagmanager.com/gtag/js?id=${cfg.ga4}`);
    }
    if (cfg.metaPixel) {
      /* Khởi tạo tối thiểu, viết tay để không kéo theo phần auto-config nặng. */
      const fbq: any = (...a: unknown[]) => { fbq.queue.push(a); };
      fbq.queue = []; fbq.loaded = true; fbq.version = '2.0';
      w.fbq = fbq;
      fbq('init', cfg.metaPixel);
      fbq('track', 'PageView');
      inject('https://connect.facebook.net/en_US/fbevents.js');
    }
    if (cfg.tiktokPixel) {
      inject(`https://analytics.tiktok.com/i18n/pixel/events.js?sdkid=${cfg.tiktokPixel}`);
    }

    for (const e of queue.splice(0)) forward(e.name, e.params);
  }

  function consentDecision(): 'yes' | 'no' | null {
    try {
      const v = localStorage.getItem(CONSENT_KEY);
      return v === 'yes' || v === 'no' ? v : null;
    } catch { return null; }
  }

  function arm() {
    if (!cfg.ga4 && !cfg.metaPixel && !cfg.tiktokPixel) return;
    const decided = consentDecision();
    if (decided === 'yes') { loadVendors(); return; }
    /* Đã từ chối thì im lặng, không hỏi lại mỗi lần tải trang. Người dùng đổi ý
       được qua link trong footer. */
    if (decided === 'no') return;
    if (cfg.requireConsent) {
      const bar = document.getElementById('consent-bar');
      if (bar) {
        bar.hidden = false;
        /* Chừa chỗ cho thanh dưới đáy tài liệu, trả lại khi nó biến mất. */
        const space = (v: string) => document.documentElement.style.setProperty('--consent-h', v);
        space(`${bar.offsetHeight}px`);
        const release = () => space('0px');
        document.getElementById('consent-yes')?.addEventListener('click', () => {
          try { localStorage.setItem(CONSENT_KEY, 'yes'); } catch { /* chế độ riêng tư */ }
          bar.hidden = true;
          release();
          loadVendors();
        });
        document.getElementById('consent-no')?.addEventListener('click', () => {
          try { localStorage.setItem(CONSENT_KEY, 'no'); } catch { /* chế độ riêng tư */ }
          bar.hidden = true;
          release();
        });
      }
      return;
    }
    /* Không chặn luồng chính. Idle callback có thể bắn ngay khi trang còn đang
       dựng nốt, nên chỉ tính từ sau sự kiện load, và vẫn ưu tiên tương tác thật. */
    const go = () => loadVendors();
    for (const ev of ['pointerdown', 'keydown']) {
      window.addEventListener(ev, go, { once: true, passive: true });
    }
    const afterLoad = () => {
      if ('requestIdleCallback' in window) {
        (window as any).requestIdleCallback(go, { timeout: 4000 });
      } else {
        setTimeout(go, 2500);
      }
    };
    if (document.readyState === 'complete') setTimeout(afterLoad, 1200);
    else window.addEventListener('load', () => setTimeout(afterLoad, 1200), { once: true });
  }

  track('view_item');
  arm();

  /* Sự kiện từ giao diện: mọi CTA đã có data-cta, form phát mocha:lead. */
  document.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('[data-cta]');
    if (!el) return;
    const id = el.dataset.cta ?? '';
    if (id.includes('call') || id.includes('zalo')) track('contact', { method: id, cta_id: id });
    else track('begin_checkout', { cta_id: id });
  });

  let started = false;
  document.getElementById('order-form')?.addEventListener('input', () => {
    if (started) return;
    started = true;
    track('form_start');
  });
  window.addEventListener('mocha:lead', (e) => {
    track('generate_lead', { pack: (e as CustomEvent).detail?.pack });
  });

</script>
