---
/**
 * Khung section của bản trình bày `flagship`.
 *
 * Cùng hợp đồng với `Section.astro` — `data-narrative-role`, neo nhận focus,
 * CTA cuối khối, câu nối, nhóm xuất hiện khi cuộn — để cổng QA đọc trang này
 * y như đọc trang chuẩn. Khác ở chỗ nó cho phép nền tràn lề riêng (`tone`) và
 * tự vẽ phần đầu mục, vì mỗi khối flagship bố cục tiêu đề theo nội dung của
 * nó chứ không theo một khuôn chung.
 */
interface Props {
  id?: string;
  tone?: 'paper' | 'bone' | 'night' | 'stage';
  role?: string;
  transition?: string;
  cta?: { note?: string; label: string; href: string };
  focusTarget?: boolean;
  eyebrow?: string;
  heading?: string;
  intro?: string;
  /** Đầu mục: xếp chồng (mặc định), căn giữa, hay tách hai cột. */
  head?: 'stack' | 'center' | 'split';
  /** Khối tự vẽ tiêu đề của mình, với id `${id}-title`. */
  labelled?: boolean;
  class?: string;
}
const {
  id, tone = 'paper', role, transition, cta, focusTarget = false,
  eyebrow, heading, intro, head = 'stack', labelled = false, class: cls,
} = Astro.props;
const headingId = id ? `${id}-title` : undefined;
---
<section
  id={id}
  class:list={['fx-sec', `tone-${tone}`, cls]}
  aria-labelledby={heading || labelled ? headingId : undefined}
  tabindex={focusTarget ? -1 : undefined}
  data-narrative-role={role}
  data-reveal-group
>
  <slot name="bleed" />
  <div class="wrap">
    {heading && (
      <div class:list={['fx-head', `head-${head}`]} data-reveal>
        <div>
          {eyebrow && <p class="fx-eyebrow">{eyebrow}</p>}
          <h2 id={headingId}>{heading}</h2>
        </div>
        {intro && <p class="fx-intro">{intro}</p>}
      </div>
    )}
    <slot />
    {cta && (
      <div class="fx-cta" data-reveal>
        {cta.note && <p class="fx-cta-note">{cta.note}</p>}
        <a class="fx-cta-link" href={cta.href} data-cta={`inline-${role ?? 'section'}`}>{cta.label}</a>
      </div>
    )}
    {transition && <p class="fx-transition" data-reveal>{transition}</p>}
  </div>
</section>

<style>
  .fx-sec {
    position: relative;
    padding-block: clamp(72px, 9vw, 136px);
    overflow: clip;           /* nền trang trí tràn lề không được sinh thanh cuộn ngang */
  }
  .fx-sec:focus { outline: none; }
  .fx-sec > .wrap { position: relative; }

  .tone-paper { background: var(--paper); }
  .tone-bone  { background: var(--bone); }
  .tone-stage {
    background:
      radial-gradient(60% 70% at 85% 10%, rgba(63, 74, 214, .10), transparent 70%),
      linear-gradient(180deg, var(--stage-a), var(--stage-b));
  }
  .tone-night { background: var(--night); color: #fff; }
  .tone-night :global(h2), .tone-night :global(h3) { color: #fff; }

  /* ---- đầu mục ---- */
  .fx-head { margin-bottom: clamp(40px, 5vw, 72px); max-width: 30ch; }
  .fx-head h2 {
    font-size: clamp(2rem, 4.6vw, 3.4rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
    margin: 0;
  }
  .fx-intro {
    margin: var(--s-5) 0 0;
    max-width: 52ch;
    font-size: var(--t-md);
    line-height: 1.6;
    color: var(--ink-muted);
    text-wrap: pretty;
  }
  .head-center { margin-inline: auto; text-align: center; max-width: 34ch; }
  .head-center .fx-intro { margin-inline: auto; }
  .head-center .fx-eyebrow { justify-content: center; }
  @media (min-width: 960px) {
    .head-split {
      display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: clamp(32px, 5vw, 96px); max-width: none; align-items: end;
    }
    .head-split .fx-intro { margin: 0; }
  }
  .tone-night .fx-intro { color: var(--on-night-muted); }

  .fx-eyebrow {
    display: flex; align-items: center; gap: var(--s-3);
    margin: 0 0 var(--s-5);
    font-size: var(--t-2xs); font-weight: 600;
    letter-spacing: .22em; text-transform: uppercase;
    color: var(--cobalt);
  }
  .fx-eyebrow::before {
    content: ""; width: 8px; height: 8px; border-radius: 50%;
    background: currentColor; box-shadow: 0 0 0 4px rgba(43, 52, 184, .14);
  }
  .tone-night .fx-eyebrow { color: var(--glow); }
  .tone-night .fx-eyebrow::before { box-shadow: 0 0 0 4px rgba(143, 152, 255, .18); }

  /* ---- CTA cuối khối + câu nối: cùng vai với bản chuẩn ---- */
  .fx-cta {
    margin-top: clamp(40px, 5vw, 64px);
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3) var(--s-5);
  }
  .fx-cta-note { margin: 0; color: var(--ink-muted); }
  .fx-cta-link {
    display: inline-flex; align-items: center; gap: var(--s-2);
    min-height: 48px; padding: 0 22px;
    border-radius: 999px;
    background: var(--ink-navy); color: #fff;
    font-weight: 600; font-size: var(--t-sm); letter-spacing: .02em;
    text-decoration: none;
    transition: background-color var(--dur-2) var(--ease), transform var(--dur-1) var(--ease);
  }
  .fx-cta-link::after { content: "\2193"; }
  .fx-cta-link:hover { background: var(--cobalt); color: #fff; }
  @media (hover: hover) { .fx-cta-link:hover { transform: translateY(-1px); } }
  .tone-night .fx-cta-note { color: var(--on-night-muted); }
  .tone-night .fx-cta-link { background: #fff; color: var(--night); }
  .tone-night .fx-cta-link:hover { background: var(--glow); color: var(--night); }

  .fx-transition {
    margin: clamp(48px, 6vw, 80px) 0 0;
    max-width: 40ch;
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--ink-navy);
    text-wrap: pretty;
  }
  .fx-transition::before {
    content: ""; display: block; width: 40px; height: 2px;
    background: var(--cobalt); margin-bottom: var(--s-4);
  }
  .tone-night .fx-transition { color: #fff; }
  .tone-night .fx-transition::before { background: var(--glow); }
</style>
