---
/**
 * Sân khấu sản phẩm — dùng chung cho hero trang sản phẩm, trang chủ và trang dòng.
 *
 * MỘT ảnh nền trắng (bộ `hero-*.webp`, đã chuẩn hoá lề) đứng giữa quỹ đạo và hoà
 * vào nền bằng `multiply`. Bản trước có thêm bố cục khung vòm cho ảnh chụp và
 * bố cục hai ảnh; ảnh chụp độ phân giải thấp bị cắt + phóng to nên mờ, và các
 * trang không cân nhau — nên chỉ giữ một bố cục.
 *
 * Chip: `doses` có `value` thì là con số in trên bao bì; không có thì là tên
 * hoạt chất chủ lực. Component không bao giờ tự sinh số.
 */
import Picture from '../Picture.astro';
interface Dose { value?: string | null; unit?: string | null; name: string; product?: string | null }
interface Props {
  image: { src: string; alt: string };
  doses?: Dose[];
  motto: string;
  /** Nhãn của danh sách chip (đọc cho trình đọc màn hình). */
  chipsLabel: string;
  /** Nhãn phụ dưới chip khi chip không có số và không thuộc sản phẩm con nào. */
  keyLabel?: string;
}
const { image, doses = [], motto, chipsLabel, keyLabel } = Astro.props;
const numbered = doses.some((d) => d.value);
---
<div class="stage">
  <span class="rings" aria-hidden="true"></span>
  <svg class="motto" viewBox="0 0 200 200" aria-hidden="true">
    <defs><path id="fx-motto" d="M100,100 m-84,0 a84,84 0 1,1 168,0 a84,84 0 1,1 -168,0" /></defs>
    <text><textPath href="#fx-motto" textLength="524" lengthAdjust="spacing">{motto}</textPath></text>
  </svg>

  {/* Không `fetchpriority="high"`: đo trên 4G mô phỏng, ảnh ưu tiên cao giành
      băng thông của font đã preload, mà lần vẽ đầu phải chờ font — LCP lên
      2.772ms. */}
  <div class="front">
    <Picture src={image.src} alt={image.alt}
      sizes="(min-width: 960px) 42vw, 86vw" widths={[360, 480, 720, 960]}
      loading="eager" decoding="async" />
  </div>

  {doses.length > 0 && (
    <ul class="doses" aria-label={chipsLabel}>
      {doses.map((d: any, i: number) => (
        <li class={`dose d${i + 1}`}>
          {d.value
            ? <span class="v figure">{d.value}<small>{d.unit}</small></span>
            : <span class="k" aria-hidden="true"></span>}
          <span class="n">{d.name}{d.product ? <em>{d.product}</em> : !numbered && keyLabel && <em>{keyLabel}</em>}</span>
        </li>
      ))}
    </ul>
  )}
</div>

<style>
  /* Sân khấu KHÔNG tự cô lập (isolation): packshot hoà vào nền bằng multiply,
     nên nhóm hoà trộn phải là khung hero chứa nó (FHeroFrame đặt isolation). */
  .stage {
    position: relative;
    aspect-ratio: 1 / 1.02;
    width: 100%;
    max-width: 34rem;
    justify-self: center;
  }
  @media (min-width: 960px) {
    .stage { max-width: none; aspect-ratio: 1 / 1.1; margin-top: clamp(8px, 2vw, 24px); }
  }
  /* Vòng đồng tâm: nét tóc của tờ đặc tả, vẽ thành quỹ đạo quanh sản phẩm. */
  .rings {
    position: absolute; inset: 4% 2% 10% 8%;
    border-radius: 50%;
    background:
      radial-gradient(circle, rgba(255, 255, 255, .9) 0 34%, transparent 35%),
      repeating-radial-gradient(circle, transparent 0 46px, rgba(43, 52, 184, .10) 46px 47px);
    z-index: 0;
  }
  .motto {
    position: absolute; left: -2%; top: -1%;
    width: 30%; height: auto; overflow: visible;
    fill: var(--ink-navy);
    font-size: 15.5px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase;
    z-index: 3;
  }
  .motto text { font-family: var(--font-body); }

  /* Món đứng trước: packshot nền trắng. `multiply` biến nền trắng thành màu
     của sân khấu (trắng nhân gì cũng ra chính nó), nên sản phẩm đứng trên nền
     mà không cần tách nền bằng tay. */
  /* Ảnh vuông đã chừa lề trắng quanh sản phẩm: phóng to hơn khung một chút —
     phần tràn là nền trắng, multiply làm nó biến mất. */
  .front {
    position: absolute; left: -4%; right: -4%; bottom: -2%;
    mix-blend-mode: multiply;
    z-index: 2;
  }
  .dose .k {
    width: 12px; height: 12px; flex: 0 0 12px; border-radius: 50%;
    background: var(--cobalt); box-shadow: 0 0 0 5px rgba(43, 52, 184, .14);
  }
  /* Nền "trắng" của ảnh sau khi nén AVIF chỉ còn ~248, và 248 nhân với nền
     sân khấu vẫn để lại một ô vuông mờ nhìn thấy được. Nâng sáng 4% đẩy nó
     về 255 — phép nhân với trắng tuyệt đối mới thật sự biến mất. */
  .front :global(img) { width: 100%; height: auto; filter: brightness(1.04); }

  .doses { list-style: none; margin: 0; padding: 0; }
  .dose {
    position: absolute; z-index: 4;
    display: flex; align-items: center; gap: 12px;
    padding: 10px 16px 10px 12px;
    background: rgba(255, 255, 255, .95);
    border: 1px solid rgba(26, 29, 82, .08);
    border-radius: 16px;
    box-shadow: 0 18px 40px -18px rgba(26, 29, 82, .35);
  }
  .d1 { left: 0; top: 14%; }
  .d2 { right: 0; bottom: 18%; }
  .dose .v {
    font-size: clamp(1.6rem, 3.2vw, 2.4rem);
    line-height: 1; font-weight: 600; color: var(--cobalt);
    letter-spacing: -0.03em;
  }
  .dose .v small { font-size: .45em; margin-left: 2px; letter-spacing: 0; }
  .dose .n {
    display: grid; font-size: var(--t-xs); font-weight: 600; line-height: 1.3;
    color: var(--ink-navy);
  }
  .dose .n em {
    font-style: normal; font-weight: 500;
    font-size: var(--t-2xs); letter-spacing: .14em; text-transform: uppercase;
    color: var(--ink-muted);
  }
  @media (max-width: 520px) {
    .dose { padding: 8px 12px 8px 10px; gap: 8px; border-radius: 12px; }
    .dose .v { font-size: 1.45rem; }
    .motto { width: 32%; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .motto { animation: spin 40s linear infinite; transform-origin: 50% 50%; }
    .front { animation: float 7s var(--ease) infinite; }
    .d1 { animation: float 8s var(--ease) -2s infinite; }
    .d2 { animation: float 9s var(--ease) -5s infinite; }
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes float { 50% { transform: translate3d(0, -8px, 0); } }
</style>
