---
/**
 * Sân khấu sản phẩm — dùng chung cho hero trang sản phẩm, trang chủ và trang dòng.
 *
 * 2026-10: ảnh sản phẩm đứng trong một thẻ trắng, KHÔNG có gì đè lên. Bản trước hoà
 * ảnh vào nền bằng `multiply` trên các vòng quỹ đạo (vòng in xuyên qua thân sản phẩm),
 * tăng sáng ảnh 4% (bạc màu bao bì), và thả chip hoạt chất + vòng chữ xoay đè lên góc
 * ảnh. Ảnh chính phải nét và đúng: chip nay đứng thành một hàng ngay dưới ảnh.
 *
 * MỘT ảnh nền trắng (bộ `hero-*.webp`, đã chuẩn hoá lề) đứng giữa quỹ đạo và hoà
 * vào nền bằng `multiply`. Bản trước có thêm bố cục khung vòm cho ảnh chụp và
 * bố cục hai ảnh; ảnh chụp độ phân giải thấp bị cắt + phóng to nên mờ, và các
 * trang không cân nhau — nên chỉ giữ một bố cục.
 *
 * Chip: `doses` có `value` thì là con số in trên bao bì; không có thì là tên
 * hoạt chất chủ lực. Component không bao giờ tự sinh số.
 */
import Picture from '../Picture.astro';
interface Dose { value?: string | null; unit?: string | null; name: string; product?: string | null }
interface Props {
  image: { src: string; alt: string };
  doses?: Dose[];
  motto: string;
  /** Nhãn của danh sách chip (đọc cho trình đọc màn hình). */
  chipsLabel: string;
  /** Nhãn phụ dưới chip khi chip không có số và không thuộc sản phẩm con nào. */
  keyLabel?: string;
}
const { image, doses = [], motto, chipsLabel, keyLabel } = Astro.props;
const numbered = doses.some((d) => d.value);
---
<div class="stage">
  {/* Không `fetchpriority="high"`: đo trên 4G mô phỏng, ảnh ưu tiên cao giành
      băng thông của font đã preload, mà lần vẽ đầu phải chờ font — LCP lên
      2.772ms. */}
  <div class="card">
    <Picture src={image.src} alt={image.alt} ratio="1/1" fit="contain"
      sizes="(min-width: 960px) 42vw, 86vw" widths={[360, 480, 720, 960, 1200]}
      loading="eager" decoding="async" />
  </div>

  {doses.length > 0 && (
    <ul class="doses" aria-label={chipsLabel}>
      {doses.map((d: any) => (
        <li class="dose">
          {d.value
            ? <span class="v figure">{d.value}<small>{d.unit}</small></span>
            : <span class="k" aria-hidden="true"></span>}
          <span class="n">{d.name}{d.product ? <em>{d.product}</em> : !numbered && keyLabel && <em>{keyLabel}</em>}</span>
        </li>
      ))}
    </ul>
  )}
</div>

<style>
  .stage { width: 100%; max-width: 34rem; justify-self: center; }
  @media (min-width: 960px) { .stage { max-width: none; margin-top: clamp(8px, 2vw, 24px); } }
  .card {
    background: #fff; border-radius: 24px; overflow: hidden;
    box-shadow: 0 0 0 1px rgba(26, 29, 82, .06), 0 30px 60px -40px rgba(26, 29, 82, .35);
  }
  .card :global(img) { display: block; width: 100%; height: auto; }

  .doses { list-style: none; margin: var(--s-4) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-3); }
  .dose {
    display: flex; align-items: center; gap: 10px;
    padding: 8px 14px 8px 10px;
    background: #fff; border: 1px solid rgba(26, 29, 82, .1); border-radius: 14px;
  }
  .dose .k { width: 10px; height: 10px; flex: 0 0 10px; border-radius: 50%; background: var(--cobalt); box-shadow: 0 0 0 4px rgba(43, 52, 184, .14); }
  .dose .v { font-size: clamp(1.3rem, 2.4vw, 1.8rem); line-height: 1; font-weight: 600; color: var(--cobalt); letter-spacing: -0.03em; }
  .dose .v small { font-size: .5em; margin-left: 2px; letter-spacing: 0; }
  .dose .n { display: grid; font-size: var(--t-xs); font-weight: 600; line-height: 1.3; color: var(--ink-navy); }
  .dose .n em { font-style: normal; font-weight: 500; font-size: var(--t-2xs); letter-spacing: .14em; text-transform: uppercase; color: var(--ink-muted); }
</style>
