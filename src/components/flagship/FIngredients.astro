---
import FSection from './FSection.astro';
import { t, type Locale } from '../../i18n/ui';
import { splitDose, groupRows } from '../../lib/flagship';
interface Props { data: any; id?: string; locale: Locale; role?: string; transition?: string; cta?: any; }
const { data, id = 'thanh-phan', locale, role, transition, cta } = Astro.props;

/**
 * Bảng thành phần là lý do trang này tồn tại: Mocha in nồng độ lên bao bì
 * trong khi phần lớn thị trường không in. Bản chuẩn đặt nó trong một bảng 12
 * dòng chữ đều nhau — đúng, nhưng con số không bao giờ thành khoảnh khắc.
 *
 * Ở đây con số là nhân vật chính: đặt bằng face chữ số ở cỡ hiển thị, trên
 * nền tối để nó là "căn phòng" duy nhất khác hẳn phần còn lại của trang. Tên
 * đầy đủ (kể cả nồng độ) vẫn nằm nguyên văn trong HTML, nên máy đọc và trình
 * đọc màn hình nhận đúng chuỗi "Tranexamic Acid 3%" như bao bì in.
 */
const groups = groupRows(data.rows as any[]).map((g) => ({
  ...g,
  rows: g.rows.map((r: any) => ({ ...r, dose: splitDose(r.name) })),
}));
const total = data.rows.filter((r: any) => splitDose(r.name).value).length;
/* Không in nồng độ nào: số lớn đếm HOẠT CHẤT, và bỏ câu "cái nào có số thì
   ghi số" — câu đó chỉ đúng khi trên bao bì thật sự có số. */
const counted = total > 0 ? total : data.rows.length;
---
<FSection id={id} tone="night" role={role} transition={transition} cta={cta} labelled>
  <div slot="bleed" class="glow" aria-hidden="true"></div>

  <div class="head" data-reveal>
    <div>
      {data.eyebrow && <p class="eb">{data.eyebrow}</p>}
      <h2 id={`${id}-title`}>{data.heading}</h2>
    </div>
    <div class="count">
      <span class="big figure">{counted}</span>
      <span>
        {total > 0
          ? <strong>{t(locale, 'fx.motto')}.</strong>
          : <strong>{counted} {t(locale, 'table.activeCount')}.</strong>}
        {' '}{data.intro}
      </span>
    </div>
  </div>

  <div class="groups">
    {groups.map((g) => (
      <section class="grp" aria-label={g.label ?? data.heading} data-reveal>
        {g.label && (
          <header class="gh">
            <h3>{g.label}</h3>
            <span>{g.rows.length} {t(locale, 'table.activeCount')}</span>
          </header>
        )}
        <ul class="tiles">
          {g.rows.map((r: any) => (
            <li>
              <p class="nm">
                {r.dose.value
                  ? <span class="v figure">{r.dose.value}<small>{r.dose.unit}</small></span>
                  : null}
                <span class:list={['label', !r.dose.value && 'solo']}>{r.dose.name}{r.dose.value && <span class="sr-only"> {r.dose.value}{r.dose.unit}</span>}</span>
              </p>
              <p class="role">{r.role}</p>
              <p class="fit">{r.suitedFor}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  {data.caption && <p class="cap">{data.caption}</p>}
</FSection>

<style>
  .glow {
    /* Không lấn ra hai bên: phần tử thò khỏi khung nhìn là lỗi của cổng đáp ứng
       dù section đã cắt (overflow: clip). */
    position: absolute; inset: -10% 0 auto; height: 80%;
    background:
      radial-gradient(40% 50% at 20% 30%, rgba(63, 74, 214, .45), transparent 70%),
      radial-gradient(35% 45% at 85% 10%, rgba(143, 152, 255, .22), transparent 70%);
    pointer-events: none;
  }

  .head {
    display: grid; gap: var(--s-6);
    margin-bottom: clamp(48px, 6vw, 88px);
  }
  @media (min-width: 960px) { .head { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); align-items: end; gap: clamp(40px, 6vw, 112px); } }
  .eb {
    display: flex; align-items: center; gap: var(--s-3);
    margin: 0 0 var(--s-5);
    font-size: var(--t-2xs); font-weight: 600; letter-spacing: .22em; text-transform: uppercase;
    color: var(--glow);
  }
  .eb::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: currentColor; box-shadow: 0 0 0 4px rgba(143, 152, 255, .18); }
  h2 {
    margin: 0;
    font-size: clamp(2.2rem, 5.2vw, 4rem); line-height: 1; letter-spacing: -0.04em;
    color: #fff; max-width: 16ch;
  }
  .count { display: grid; grid-template-columns: auto 1fr; gap: var(--s-5); align-items: center; }
  .count .big {
    font-size: clamp(4.5rem, 9vw, 7.5rem); line-height: .85; font-weight: 600;
    color: var(--glow); letter-spacing: -0.05em;
  }
  .count strong { color: #fff; }
  .count span:last-child { color: var(--on-night-muted); font-size: var(--t-base); line-height: 1.6; max-width: 36ch; }

  .groups { display: grid; gap: var(--s-6); align-items: start; }
  @media (min-width: 1100px) { .groups { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-6); } }

  .grp {
    padding: clamp(20px, 2.4vw, 32px);
    border-radius: 28px;
    background: linear-gradient(180deg, rgba(255, 255, 255, .06), rgba(255, 255, 255, .02));
    border: 1px solid rgba(255, 255, 255, .10);
  }
  .gh { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-4); margin-bottom: var(--s-5); padding: 0 4px; }
  .gh h3 { margin: 0; font-size: clamp(1.4rem, 2.4vw, 1.9rem); letter-spacing: -0.02em; color: #fff; }
  .gh span { font-size: var(--t-xs); font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--on-night-muted); }

  .tiles { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  @media (min-width: 560px) { .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .tiles li {
    display: flex; flex-direction: column; gap: var(--s-2);
    padding: var(--s-5);
    border-radius: 18px;
    background: var(--night-2);
    border: 1px solid rgba(255, 255, 255, .06);
    transition: border-color var(--dur-2) var(--ease), transform var(--dur-2) var(--ease), background-color var(--dur-2) var(--ease);
  }
  @media (hover: hover) {
    .tiles li:hover { border-color: rgba(143, 152, 255, .55); transform: translateY(-2px); }
  }
  .nm { margin: 0 0 var(--s-2); display: grid; gap: var(--s-2); }
  .v {
    font-size: clamp(2.6rem, 4.4vw, 3.5rem); line-height: .9; font-weight: 600;
    color: var(--glow); letter-spacing: -0.04em;
  }
  .v small { font-size: .38em; margin-left: 3px; letter-spacing: 0; color: var(--on-night-muted); }
  .label { font-weight: 600; font-size: var(--t-base); color: #fff; letter-spacing: -0.01em; }
  /* Hoạt chất không in nồng độ: tên đứng ở vị trí của con số. */
  .label.solo { font-size: clamp(1.3rem, 2vw, 1.6rem); line-height: 1.15; letter-spacing: -0.02em; color: var(--glow); }
  .role { margin: 0; font-size: var(--t-sm); line-height: 1.6; color: var(--on-night-muted); }
  .fit {
    margin: auto 0 0; padding-top: var(--s-3);
    font-size: var(--t-xs); font-weight: 600; color: #fff;
  }
  .fit::before { content: ""; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--glow); margin-right: 8px; vertical-align: middle; }

  /* Khổ hẹp: con số đứng cột trái, chữ chạy cột phải. Xếp chồng thì 12 thẻ
     cao gần 2.600px ở 390px; xếp ngang giữ nguyên chữ mà ngắn đi khoảng một
     phần ba. */
  @media (max-width: 559px) {
    .tiles li {
      display: grid; grid-template-columns: 76px minmax(0, 1fr);
      column-gap: var(--s-4); row-gap: var(--s-1);
      padding: var(--s-4);
    }
    .nm { display: contents; }
    .v { grid-row: 1 / span 3; font-size: 2.3rem; }
    .v small { display: block; margin: 4px 0 0; font-size: .42em; }
    .label, .role, .fit { grid-column: 2; }
    .fit { padding-top: var(--s-2); }
    /* thẻ không có ô số thì không chừa cột trái trống */
    .tiles li:not(:has(.v)) { grid-template-columns: minmax(0, 1fr); }
    .tiles li:not(:has(.v)) :is(.label, .role, .fit) { grid-column: 1; }
  }

  .cap { margin: var(--s-6) 0 0; max-width: 72ch; font-size: var(--t-xs); line-height: 1.6; color: var(--on-night-muted); }
</style>
