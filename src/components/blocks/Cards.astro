---
import Section from '../Section.astro';
import Picture from '../Picture.astro';
interface Props { data: any; id?: string; surface?: any; }
const { data, id, surface = 'bone' } = Astro.props;
---
<Section id={id} surface={surface} eyebrow={data.eyebrow} heading={data.heading} intro={data.intro}>
  <ul class="grid" style={`--cols:${data.columns}`}>
    {data.items.map((item: any) => (
      <li class="card">
        {item.image && (
          <Picture src={item.image.src} alt={item.image.alt}
            width={item.image.width} height={item.image.height}
            sizes="(min-width: 980px) 33vw, (min-width: 640px) 50vw, 100vw" />
        )}
        <div class="body">
          <h3>{item.heading}</h3>
          <p>{item.body}</p>
          {item.meta && <p class="meta">{item.meta}</p>}
        </div>
      </li>
    ))}
  </ul>
</Section>

<style>
  .grid { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--s-4); }
  @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 980px) { .grid { grid-template-columns: repeat(var(--cols, 3), 1fr); } }
  .card { padding: 0; overflow: hidden; display: flex; flex-direction: column; }
  .card :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .body { padding: var(--s-5); }
  .body h3 { margin-bottom: var(--s-2); }
  .body p { font-size: var(--t-sm); color: var(--ink-muted); }
  .meta { margin-top: var(--s-3); color: var(--ink-navy); font-weight: 600; }
</style>
