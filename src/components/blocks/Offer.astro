---
import { money, shortDate } from '../../lib/format';
import { t, type Locale } from '../../i18n/ui';
interface Props { data: any; product: any; locale: Locale; }
const { data, product: p, locale } = Astro.props;
const save = p.compareAtPrice ? p.compareAtPrice - p.price : 0;

// Trang tĩnh không tự biết hôm nay là ngày nào. Nếu hạn ưu đãi đã qua tại thời điểm
// build thì dừng build, thay vì lặng lẽ phục vụ một ưu đãi đã hết hạn.
if (data.validUntil && new Date(data.validUntil) < new Date()) {
  throw new Error(
    `Hạn ưu đãi ${data.validUntil} của "${p.slug}/${locale}" đã qua. ` +
    `Cập nhật validUntil trong file nội dung, hoặc bỏ trường này đi.`
  );
}
---
<section class="surface-navy offer" aria-labelledby="uu-dai-title">
  <div class="wrap offer-grid">
    <div>
      {data.eyebrow && <p class="eyebrow">{data.eyebrow}</p>}
      <h2 id="uu-dai-title">{data.heading}</h2>
      <p class="lead" set:html={data.body} />
      {data.notes.length > 0 && (
        <ul class="notes">{data.notes.map((n: string) => <li>{n}</li>)}</ul>
      )}
    </div>

    <div class="price-card">
      <p class="price-row">
        <span class="now tabular">{money(p.price, p.currency, locale)}</span>
        {p.compareAtPrice && (
          <span class="was tabular"><span class="sr-only">{t(locale, 'price.from')} </span>{money(p.compareAtPrice, p.currency, locale)}</span>
        )}
      </p>
      {save > 0 && (
        <p class="save tabular">{t(locale, 'price.save')} {money(save, p.currency, locale)}</p>
      )}

      <ul class="contents">
        {p.includes.map((i: any) => (
          <li><strong>{i.name}</strong>{i.note && <span class="muted"> — {i.note}</span>}</li>
        ))}
        {p.gifts.map((g: any) => (
          <li><span class="gift-tag">Quà tặng</span> <strong>{g.name}</strong>{g.note && <span class="muted"> — {g.note}</span>}</li>
        ))}
      </ul>

      {data.validUntil && (
        <p class="valid">{t(locale, 'offer.validUntil')} <strong>{shortDate(data.validUntil, locale)}</strong></p>
      )}

      <a class="btn btn-primary btn-lg btn-block" href="#dat-hang" data-cta="offer">{t(locale, 'cta.order')}</a>
    </div>
  </div>
</section>

<style>
  .offer { padding-block: clamp(44px, 6vw, 76px); }
  .offer-grid { display: grid; gap: var(--s-6); align-items: center; }
  @media (min-width: 980px) { .offer-grid { grid-template-columns: 1.1fr .9fr; gap: var(--s-7); } }

  .notes {
    list-style: none; padding: 0; margin: var(--s-4) 0 0;
    display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5);
    font-size: var(--t-sm); color: rgba(255, 255, 255, .78);
  }

  .price-card {
    background: var(--paper); color: var(--ink);
    border-radius: var(--r-card); padding: var(--s-5);
    box-shadow: var(--shadow-2);
  }
  .price-row { display: flex; align-items: baseline; gap: var(--s-3); margin: 0; flex-wrap: wrap; }
  .now { font-family: var(--font-display); font-size: var(--t-2xl); font-weight: 600; color: var(--ink-navy); line-height: 1; }
  .was { color: var(--ink-muted); text-decoration: line-through; font-size: var(--t-sm); }
  .save { color: var(--green-clinic); font-weight: 600; font-size: var(--t-sm); margin: var(--s-2) 0 var(--s-4); }

  .contents { list-style: none; padding: 0; margin: 0 0 var(--s-4); display: grid; gap: var(--s-2); font-size: var(--t-sm); }
  .contents strong { color: var(--ink-navy); }
  .gift-tag {
    display: inline-block; background: var(--violet-mist); color: var(--indigo);
    font-size: var(--t-xs); font-weight: 600; padding: 1px 8px; border-radius: 999px;
  }
  .valid { font-size: var(--t-sm); color: var(--ink-muted); margin-bottom: var(--s-4); }
</style>
