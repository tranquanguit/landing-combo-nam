---
import Section from '../Section.astro';
import { richText } from '../../lib/richtext';

interface Props {
  data: {
    eyebrow?: string; heading: string; body?: string;
    primary: { label: string; href: string };
    secondary?: { label: string; href: string };
  };
  id?: string;
  surface?: 'bone' | 'paper' | 'mist' | 'navy';
  space?: 'sm' | 'md' | 'lg';
  sameSurface?: boolean;
}
const { data, id, surface = 'navy', space, sameSurface } = Astro.props;
---
<Section id={id} surface={surface} space={space} sameSurface={sameSurface} center>
  <div class="fc">
    {data.eyebrow && <p class="eyebrow">{data.eyebrow}</p>}
    <h2>{data.heading}</h2>
    {data.body && <p class="lead" set:html={richText(data.body)} />}
    <div class="fc-acts">
      <a class="btn btn-primary btn-lg" href={data.primary.href} data-cta="final-primary">{data.primary.label}</a>
      {data.secondary && (
        <a class="btn btn-ghost" href={data.secondary.href} data-cta="final-secondary">{data.secondary.label}</a>
      )}
    </div>
  </div>
</Section>

<style>
  /* Căn giữa và hẹp lại. Đây là khối duy nhất trên trang cố ý KHÔNG có gì để
     đọc tiếp — mọi thứ khác đã nói xong ở trên. Một cột chữ rộng ở đây sẽ mời
     người đọc đọc thêm, đúng thứ không nên làm ở dòng cuối. */
  .fc { max-width: 44ch; margin-inline: auto; text-align: center; }
  .fc .lead { margin-bottom: var(--s-6); }
  .fc-acts {
    display: flex; flex-wrap: wrap; gap: var(--s-3); justify-content: center;
  }
</style>
