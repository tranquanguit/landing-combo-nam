---
import Section from '../Section.astro';
import ProductGrid from '../ProductGrid.astro';
import { richText } from '../../lib/richtext';
import type { Locale } from '../../i18n/ui';

interface Props {
  data: { eyebrow?: string; heading: string; intro?: string; items: string[] };
  /** Thẻ sản phẩm đã dựng sẵn ở route, theo đúng thứ tự khai trong `items`. */
  products: any[];
  locale: Locale;
  id?: string;
  surface?: 'bone' | 'paper' | 'mist' | 'navy';
  space?: 'sm' | 'md' | 'lg';
  sameSurface?: boolean;
}
const { data, products, locale, id, surface = 'bone', space, sameSurface } = Astro.props;
---
{/* Không có sản phẩm nào phân giải được thì KHÔNG dựng khối rỗng: một tiêu đề
    "Bạn có thể quan tâm" đứng trên khoảng trắng tệ hơn là không có gì. */}
{products.length > 0 && (
  <Section id={id} surface={surface} space={space} sameSurface={sameSurface}
    eyebrow={data.eyebrow} heading={data.heading}>
    {data.intro && <p class="rp-intro" set:html={richText(data.intro)} />}
    <ProductGrid products={products} locale={locale} />
  </Section>
)}

<style>
  .rp-intro { max-width: 58ch; margin: 0 0 var(--s-6); color: var(--ink-muted); }
</style>
