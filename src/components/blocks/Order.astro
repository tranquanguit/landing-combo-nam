---
import { money } from '../../lib/format';
import { t, type Locale } from '../../i18n/ui';
interface Props { data: any; product: any; brand: any; locale: Locale; }
const { data, product: p, brand: b, locale } = Astro.props;

// Endpoint nhận đơn. Chưa cấu hình thì form KHÔNG giả vờ đã gửi thành công —
// thay vào đó hiện lối liên hệ thật, vì một đơn hàng rơi vào hư không tệ hơn
// nhiều so với một nút không hoạt động.
const endpoint = import.meta.env.PUBLIC_ORDER_ENDPOINT || null;
---
<section id="dat-hang" class="surface-navy defer" aria-labelledby="dat-hang-title">
  <div class="wrap order-grid">
    <div>
      {data.eyebrow && <p class="eyebrow">{data.eyebrow}</p>}
      <h2 id="dat-hang-title">{data.heading}</h2>
      <p class="lead" set:html={data.body} />
      <ul class="points">
        {data.points.map((pt: string) => <li set:html={pt} />)}
      </ul>
      <p class="hotline">
        <a href={`tel:${b.phone}`} data-cta="order-call">{b.phoneDisplay}</a>
        {b.zalo && <> · <a href={b.zalo} rel="noopener" data-cta="order-zalo">Zalo</a></>}
      </p>
    </div>

    <div class="form-card on-light">
      <form
        id="order-form"
        method="post"
        action={endpoint ?? undefined}
        data-endpoint={endpoint ? 'configured' : 'missing'}
        data-action={endpoint ?? undefined}
        novalidate
      >
        {p.variants.length > 0 && (
          <fieldset>
            <legend class="sr-only">{t(locale, 'form.selectPack')}</legend>
            <div class="packs">
              {p.variants.map((v: any, i: number) => (
                <label class="pack">
                  <input
                    type="radio" name="pack" value={v.label}
                    data-price={v.price ?? ''}
                    data-price-text={v.price === null ? '' : money(v.price, p.currency, locale)}
                    checked={v.recommended || i === 0}
                  />
                  <span class="pack-text">
                    <strong>{v.label}</strong>
                    {v.note && <span class="muted">{v.note}</span>}
                  </span>
                  <span class="pack-price tabular">
                    {v.price === null ? t(locale, 'form.noPrice') : money(v.price, p.currency, locale)}
                  </span>
                </label>
              ))}
            </div>
          </fieldset>
        )}

        <div class="field" data-field="name">
          <label for="name">{t(locale, 'form.name')} <span aria-hidden="true">*</span></label>
          <input type="text" id="name" name="name" autocomplete="name" required
            aria-describedby="name-err" placeholder={t(locale, 'form.phName')} />
          <p class="err" id="name-err">{t(locale, 'form.errName')}</p>
        </div>

        <div class="field" data-field="phone">
          <label for="phone">{t(locale, 'form.phone')} <span aria-hidden="true">*</span></label>
          <input type="tel" id="phone" name="phone" autocomplete="tel" inputmode="numeric" required
            aria-describedby="phone-hint phone-err" placeholder={t(locale, 'form.phPhone')} />
          <p class="hint" id="phone-hint">{t(locale, 'form.privacy')}</p>
          <p class="err" id="phone-err">{t(locale, 'form.errPhone')}</p>
        </div>

        <div class="field" data-field="address">
          <label for="address">{t(locale, 'form.address')} <span aria-hidden="true">*</span></label>
          <input type="text" id="address" name="address" autocomplete="street-address" required
            aria-describedby="address-err" placeholder={t(locale, 'form.phAddress')} />
          <p class="err" id="address-err">{t(locale, 'form.errAddress')}</p>
        </div>

        {locale !== 'vi' && (
          <div class="field" data-field="country">
            <label for="country">{t(locale, 'form.country')} <span aria-hidden="true">*</span></label>
            <input type="text" id="country" name="country" autocomplete="country-name" required
              aria-describedby="country-err" />
            <p class="err" id="country-err">{t(locale, 'form.errCountry')}</p>
          </div>
        )}

        <div class="field">
          <label for="note">{t(locale, 'form.note')}</label>
          <textarea id="note" name="note" rows="2"></textarea>
        </div>

        <p class="total" id="order-total" data-currency={p.currency} data-locale={locale}>
          {t(locale, 'form.total')} <strong class="tabular" data-total>{money(p.price, p.currency, locale)}</strong>
          <span class="muted"> {t(locale, 'form.totalNote')}</span>
        </p>

        <button
          type="submit"
          class="btn btn-primary btn-lg btn-block"
          data-cta="form-submit"
          aria-disabled={endpoint ? undefined : 'true'}
          aria-describedby={endpoint ? undefined : 'form-no-endpoint'}
        >
          {t(locale, 'form.submit')}
        </button>
      </form>

      <p class="ok" id="form-success" role="status" hidden>{t(locale, 'form.success')}</p>

      <p class="fail" id="form-error" role="alert" hidden>
        {t(locale, 'form.failed')} <a href={`tel:${b.phone}`}>{b.phoneDisplay}</a>
      </p>

      {!endpoint && (
        <p class="todo" id="form-no-endpoint" data-todo>
          ⚠️ {t(locale, 'form.noEndpoint')} <a href={`tel:${b.phone}`}>{b.phoneDisplay}</a>
        </p>
      )}
    </div>
  </div>
</section>

<style>
  .order-grid { display: grid; gap: var(--s-6); align-items: start; }
  @media (min-width: 940px) { .order-grid { grid-template-columns: 1fr 1.05fr; gap: var(--s-7); } }

  .points { list-style: none; padding: 0; margin: var(--s-5) 0; display: grid; gap: var(--s-3); }
  .points li { padding-left: var(--s-5); position: relative; color: rgba(255, 255, 255, .88); }
  .points li::before {
    content: ""; position: absolute; left: 0; top: .62em;
    width: 8px; height: 8px; border-radius: 50%; background: #7de0b4;
  }
  .hotline a {
    color: #b9c0ff; font-weight: 600;
    display: inline-block; min-height: 24px; line-height: 24px;
  }

  .form-card { background: var(--paper); color: var(--ink); border-radius: var(--r-card); padding: var(--s-5); box-shadow: var(--shadow-2); }
  fieldset { border: 0; padding: 0; margin: 0 0 var(--s-4); }
  .packs { display: grid; gap: var(--s-2); }
  .pack {
    display: flex; align-items: flex-start; gap: var(--s-3);
    border: 1.5px solid var(--line-control); border-radius: var(--r-card);
    padding: var(--s-3) var(--s-4); cursor: pointer; background: var(--bone);
  }
  .pack:hover { border-color: var(--indigo-lift); }
  .pack:has(input:checked) { border-color: var(--indigo); background: var(--paper); }
  .pack input { margin-top: 2px; width: 24px; height: 24px; accent-color: var(--indigo); flex: 0 0 auto; }
  .pack-text strong { display: block; color: var(--ink-navy); font-size: var(--t-sm); }
  .pack-text .muted { font-size: var(--t-xs); }
  .pack-price { margin-left: auto; font-weight: 600; color: var(--ink-navy); white-space: nowrap; font-size: var(--t-sm); }

  .field { margin-bottom: var(--s-4); }
  .field label { display: block; font-weight: 600; font-size: var(--t-sm); margin-bottom: 5px; color: var(--ink-navy); }
  input, textarea {
    width: 100%; font: inherit; font-size: var(--t-base); padding: 12px 14px;
    border: 1.5px solid var(--line-control); border-radius: var(--r-input);
    background: var(--bone); color: var(--ink);
  }
  /* Không dùng outline:none — nó đè lên :focus-visible trong tokens.css và xoá
     sạch chỉ báo bàn phím. Viền dày hơn chỉ là trang trí thêm. */
  input:focus-visible, textarea:focus-visible {
    border-color: var(--indigo);
    background: var(--paper);
    outline: 3px solid var(--indigo-lift);
    outline-offset: 2px;
  }
  input:focus:not(:focus-visible), textarea:focus:not(:focus-visible) {
    border-color: var(--indigo); background: var(--paper);
  }
  .pack:focus-within { outline: 3px solid var(--indigo-lift); outline-offset: 2px; }
  .hint { font-size: var(--t-xs); color: var(--ink-muted); margin: 5px 0 0; }
  .err { font-size: var(--t-xs); color: #b3261e; margin: 5px 0 0; display: none; }
  .field[data-invalid] input { border-color: #b3261e; }
  .field[data-invalid] .err { display: block; }

  .total { font-size: var(--t-sm); margin: var(--s-4) 0; }
  .total strong { color: var(--ink-navy); }
  .fail {
    background: #fdeceb; border: 1.5px solid #b3261e; color: #7c1d16;
    border-radius: var(--r-card); padding: var(--s-4); font-weight: 600; margin: var(--s-3) 0 0;
  }
  button[data-busy] { opacity: .6; pointer-events: none; }
  /* aria-disabled thay cho disabled để nút vẫn nhận được focus và trình đọc
     màn hình vẫn đọc được lời giải thích kèm theo. Màu giữ đủ tương phản. */
  button[aria-disabled='true'] { background: #6b7280; cursor: not-allowed; }
  .ok {
    background: #e6f4ee; border: 1.5px solid var(--green-clinic); color: #0a4b38;
    border-radius: var(--r-card); padding: var(--s-4); font-weight: 600; margin: 0;
  }
</style>

<script>
  const form = document.getElementById('order-form') as HTMLFormElement | null;

  if (form) {
    /* Chấp nhận cả 0912345678, +84912345678 và 84912345678 — khách hay dán
       số ở định dạng quốc tế từ Zalo. Chuẩn hóa về dạng 0xxxxxxxxx rồi mới kiểm. */
    /* CSS scroll-behavior đã tôn trọng prefers-reduced-motion, nhưng lệnh JS thì không. */
    const scrollBehaviour = (): ScrollBehavior =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';

    const normalisePhone = (v: string) =>
      v.replace(/[\s.\-()]/g, '').replace(/^\+?84/, '0');

    const vietnameseOnly = document.documentElement.lang.startsWith('vi');

    const rules: Record<string, (v: string) => boolean> = {
      name: (v) => v.trim().length >= 2,
      phone: (v) =>
        vietnameseOnly
          ? /^0\d{9}$/.test(normalisePhone(v))
          // Thị trường quốc tế: không đoán định dạng từng nước, chỉ đòi đủ chữ số.
          : /^\+?[\d\s.\-()]{7,20}$/.test(v.trim()) && (v.match(/\d/g)?.length ?? 0) >= 7,
      address: (v) => v.trim().length >= 8,
      country: (v) => v.trim().length >= 2,
    };

    const check = (el: HTMLInputElement) => {
      const ok = rules[el.name] ? rules[el.name](el.value) : true;
      el.closest('.field')?.toggleAttribute('data-invalid', !ok);
      el.setAttribute('aria-invalid', ok ? 'false' : 'true');
      return ok;
    };

    for (const n of Object.keys(rules)) {
      const el = form.elements.namedItem(n) as HTMLInputElement | null;
      el?.addEventListener('blur', () => check(el));
    }

    /* Tổng tiền phải đi theo gói đang chọn, nếu không con số này là nói dối. */
    const totalBox = document.getElementById('order-total');
    const totalValue = totalBox?.querySelector('[data-total]');
    const syncTotal = () => {
      const picked = form.querySelector<HTMLInputElement>('input[name="pack"]:checked');
      if (!totalBox || !totalValue || !picked) return;
      const text = picked.dataset.priceText ?? '';
      totalBox.hidden = text === '';
      if (text) totalValue.textContent = text;
    };
    form.querySelectorAll<HTMLInputElement>('input[name="pack"]')
      .forEach((r) => r.addEventListener('change', syncTotal));
    syncTotal();

    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submitBtn?.getAttribute('aria-disabled') === 'true') {
      submitBtn.addEventListener('click', (e) => e.preventDefault());
    }

    form.addEventListener('submit', (e) => {
      let firstBad: HTMLInputElement | null = null;
      for (const n of Object.keys(rules)) {
        const el = form.elements.namedItem(n) as HTMLInputElement | null;
        if (el && !check(el) && !firstBad) firstBad = el;
      }
      if (firstBad) {
        e.preventDefault();
        firstBad.focus();
        return;
      }

      e.preventDefault();

      /* Chưa cấu hình endpoint: không gửi đi đâu và cũng không giả vờ đã gửi.
         Kiểm cờ do build đặt, KHÔNG kiểm form.action — thuộc tính đó không bao
         giờ rỗng, thiếu action thì nó trả về URL của chính trang. */
      if (form.dataset.endpoint !== 'configured') {
        const warn = document.getElementById('form-no-endpoint');
        if (warn) warn.scrollIntoView({ block: 'center', behavior: scrollBehaviour() });
        return;
      }

      const payload = Object.fromEntries(new FormData(form).entries());
      if (vietnameseOnly) payload.phone = normalisePhone(String(payload.phone ?? ''));

      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submit) { submit.disabled = true; submit.dataset.busy = 'true'; }

      fetch(form.dataset.action!, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })
        .then((res) => {
          if (!res.ok) throw new Error(String(res.status));
          form.hidden = true;
          const ok = document.getElementById('form-success');
          if (ok) { ok.hidden = false; ok.scrollIntoView({ block: 'center', behavior: scrollBehaviour() }); }
          window.dispatchEvent(new CustomEvent('mocha:lead', { detail: payload }));
        })
        .catch(() => {
          /* Gửi hỏng thì nói thật và đưa lối liên hệ khác, không nuốt lỗi. */
          const fail = document.getElementById('form-error');
          if (fail) { fail.hidden = false; fail.scrollIntoView({ block: 'center', behavior: scrollBehaviour() }); }
          if (submit) { submit.disabled = false; delete submit.dataset.busy; }
        });
    });
  }
</script>
