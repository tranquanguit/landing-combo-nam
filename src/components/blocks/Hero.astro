---
import { t, type Locale } from '../../i18n/ui';
import { money } from '../../lib/format';
import { richText } from '../../lib/richtext';
import Picture from '../Picture.astro';
interface Props { data: any; locale: Locale; product: any; }
const { data, locale, product: p } = Astro.props;

/** Chỉ những giá trị thật sự điều hướng được mới thành liên kết. */
const isLink = (v?: string): v is string => !!v && /^(#|\/|https?:\/\/)/.test(v);

/** Nhãn cho biết mỗi tuyên bố dựa trên cái gì. */
const evidenceLabel: Record<string, string> = {
  verified: t(locale, 'evidence.verified'),
  study: t(locale, 'evidence.study'),
  survey: t(locale, 'evidence.survey'),
  ingredient: t(locale, 'evidence.ingredient'),
};
---
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div>
      {data.eyebrow && <p class="eyebrow">{data.eyebrow}</p>}
      <h1 id="hero-title">{data.heading}</h1>
      <p class="lead" set:html={richText(data.lead)} />

      {/* Giá ngay ở màn hình đầu: đo được trước đây khách phải cuộn gần ba màn
          hình mới biết sản phẩm bao nhiêu tiền. */}
      <p class="hero-price">
        <span class="now tabular">{money(p.price, p.currency, locale)}</span>
        {p.compareAtPrice && p.compareAtPrice > p.price && (
          <>
            <span class="was tabular">{money(p.compareAtPrice, p.currency, locale)}</span>
            <span class="save">
              {t(locale, 'price.save')} {money(p.compareAtPrice - p.price, p.currency, locale)}
            </span>
          </>
        )}
      </p>


      <ul class="usp">
        {data.usp.map((u: any) => (
          <li>
            <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
              <circle cx="10" cy="10" r="9.25" fill="none" stroke="currentColor" stroke-width="1.5" />
              <path d="M5.8 10.3l2.7 2.7 5.7-5.9" fill="none" stroke="currentColor"
                stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>
              <span set:html={richText(u.text)} />
              <span class="basis">
                {/* source được phép là CHỮ (số phiếu công bố, tên đơn vị kiểm
                    nghiệm) — schema cố ý cho phép. Bản trước bọc mọi giá trị
                    thành href, nên đúng ngày điền số công bố thật là trang có
                    một link chết mang nhãn "có chứng từ". */}
                {isLink(u.source)
                  ? <a href={u.source} {...(u.source.startsWith('#') ? {} : { rel: 'noopener nofollow' })}>
                      {evidenceLabel[u.evidence]}
                    </a>
                  : <span>{evidenceLabel[u.evidence]}{u.source ? <> · {u.source}</> : null}</span>}
                {u.qualifier && <> · {u.qualifier}</>}
              </span>
            </span>
          </li>
        ))}
      </ul>

      <div class="hero-actions">
        <a class="btn btn-primary btn-lg" href="#dat-hang" data-cta="hero-primary">{data.primaryCta}</a>
        {data.secondaryCta && (
          <a class="btn btn-ghost" href={data.secondaryCta.href} data-cta="hero-secondary">
            {data.secondaryCta.label}
          </a>
        )}
      </div>

      {data.trustBadges.length > 0 && (
        <ul class="trust">
          {data.trustBadges.map((b: string) => <li>{b}</li>)}
        </ul>
      )}
    </div>

    <div class="hero-media">
      <Picture
        src={data.image.src}
        alt={data.image.alt}
        width={data.image.width}
        height={data.image.height}
        sizes="(min-width: 900px) 44vw, 100vw"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(36px, 5vw, 72px) clamp(32px, 4vw, 56px);
    background: linear-gradient(180deg, var(--violet-mist) 0%, var(--bone) 100%);
  }
  .hero-grid { display: grid; gap: var(--s-6); align-items: center; }
  @media (min-width: 900px) { .hero-grid { grid-template-columns: 1.05fr .95fr; gap: var(--s-7); } }

  .hero-media :global(img) {
    width: 100%;
    border-radius: var(--r-media);
    box-shadow: var(--shadow-2);
    background: var(--violet-mist);
  }

  .usp { list-style: none; padding: 0; margin: var(--s-5) 0; display: grid; gap: var(--s-3); }
  .usp li { display: flex; gap: var(--s-3); align-items: flex-start; }
  .usp svg { flex: 0 0 20px; margin-top: 5px; color: var(--green-clinic); }
  .basis {
    display: block; margin-top: 2px;
    font-size: var(--t-xs); color: var(--ink-muted);
  }
  .basis a {
    color: var(--ink-muted);
    text-decoration: underline; text-decoration-style: dotted;
    display: inline-block; min-height: 24px; line-height: 24px;
  }
  .basis a:hover { color: var(--indigo); }

  .hero-price {
    display: flex; align-items: baseline; flex-wrap: wrap;
    gap: var(--s-2) var(--s-3);
    margin: 0 0 var(--s-4);
  }
  .hero-price .now {
    font-family: var(--font-display); font-weight: 600;
    font-size: var(--t-xl); color: var(--ink-navy); line-height: 1;
  }
  .hero-price .was { color: var(--ink-muted); text-decoration: line-through; font-size: var(--t-sm); }
  .hero-price .save {
    font-size: var(--t-xs); font-weight: 600; color: var(--green-clinic);
    background: #e4f3ec; padding: 3px 10px; border-radius: 999px;
  }

  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--s-3); }

  .trust {
    list-style: none; padding: 0;
    margin: var(--s-5) 0 0;
    display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5);
    font-size: var(--t-sm); color: var(--ink-muted);
  }
</style>
