---
import type { RhythmProps } from '../../lib/narrative';
import Section from '../Section.astro';
import { t, type Locale } from '../../i18n/ui';
interface Props extends RhythmProps { data: any; id?: string; locale: Locale; }
const { data, id = 'thanh-phan', locale, surface = 'paper', space, sameSurface, role, transition, cta } = Astro.props;

/**
 * Gom hoạt chất theo SẢN PHẨM, thay vì lặp tên sản phẩm ở từng dòng.
 *
 * Đo được ở 390px trên /combo-nam/: section cao 3.406px, trong đó 12 dòng
 * chiếm 2.869px (84%). Mỗi dòng in lại giá trị "Serum" hoặc "Kem" — một
 * trường chỉ có hai giá trị, tức gần như không mang thông tin mới, nhưng
 * chiếm chỗ ở cả 12 dòng và nằm ngay cạnh con số nồng độ, thứ duy nhất cần
 * được nhìn thấy trước.
 *
 * Chuyển nó lên tiêu đề nhóm thì tổng thông tin TĂNG (biết mỗi sản phẩm có
 * bao nhiêu hoạt chất) trong khi chiều cao giảm. Đây là phân cấp, không phải
 * nén: cỡ chữ và giãn dòng giữ nguyên.
 *
 * Sản phẩm đơn lẻ không khai `inProduct` -> một nhóm không tiêu đề, hành vi
 * y như trước.
 */
const grouped: { label: string | null; rows: any[] }[] = [];
for (const r of data.rows) {
  const label = r.inProduct ?? null;
  const last = grouped[grouped.length - 1];
  if (last && last.label === label) last.rows.push(r);
  else grouped.push({ label, rows: [r] });
}
const hasGroups = grouped.some((g) => g.label);
/* Số cột sau khi bỏ cột "có trong": hoạt chất + vai trò + phù hợp với. */
const COLS = 3;

/**
 * Tách NỒNG ĐỘ ra khỏi tên hoạt chất để đặt bằng face dành cho chữ số.
 *
 *   "Tranexamic Acid 3%"          -> Tranexamic Acid <span class=pct>3%</span>
 *   "4-butylresorcinol 1000ppm"   -> 4-butylresorcinol <span class=pct>1000ppm</span>
 *
 * Bản đầu chỉ bắt dấu %, nên đúng hoạt chất được nêu ĐẦU TIÊN trên trang —
 * thứ khai bằng ppm — lại là thứ duy nhất không được đặt bằng face chữ số.
 * Công khai tỉ lệ là điểm khác biệt của sản phẩm này; đơn vị nào cũng là tỉ lệ.
 *
 * Chỉ bọc thẻ quanh chính chuỗi số; phần còn lại escape bình thường.
 */
const esc = (v: string) => v.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const splitPct = (name: string) =>
  esc(name).replace(/(\d+(?:[.,]\d+)?\s*(?:%|ppm|mg\/g|mg|IU))/gi,
    '<span class="pct">$1</span>');
---
<Section role={role} transition={transition} cta={cta} id={id} surface={surface} space={space} sameSurface={sameSurface} eyebrow={data.eyebrow} heading={data.heading} intro={data.intro}>
  {/* tabindex + role: vùng cuộn ngang phải tới được bằng bàn phím,
      nếu không người dùng chỉ có bàn phím không đọc được các cột bên phải. */}
  <div class="scroll" tabindex="0" role="region" aria-label={data.heading}>
    <table>
      {data.caption && <caption>{data.caption}</caption>}
      <thead>
        <tr>
          <th scope="col">{t(locale, 'table.ingredient')}</th>
          <th scope="col">{t(locale, 'table.role')}</th>
          <th scope="col">{t(locale, 'table.suitedFor')}</th>
        </tr>
      </thead>
      {grouped.map((g) => (
        <tbody>
          {g.label && (
            /* scope="colgroup" là cách đúng để một hàng làm tiêu đề cho cả
               nhóm bên dưới TRONG một bảng. Không dùng <h3> ở đây: heading
               không hợp lệ bên trong <table>, và trình đọc màn hình đã có
               quan hệ nhóm sẵn qua scope. */
            <tr class="group">
              <th scope="colgroup" colspan={COLS}>
                <span class="group-name">{g.label}</span>
                <span class="group-count">{g.rows.length} {t(locale, 'table.activeCount')}</span>
              </th>
            </tr>
          )}
          {g.rows.map((r: any) => (
            <tr>
              <th scope="row">
                <span class="name" set:html={splitPct(r.name)} />
                {r.reference && (
                  <> <a href={r.reference} rel="noopener nofollow" target="_blank" class="ref">{t(locale, 'table.source')}</a></>
                )}
                {r.referenceNote && <span class="ref-note">{r.referenceNote}</span>}
              </th>
              <td data-label={t(locale, 'table.role')}>{r.role}</td>
              <td data-label={t(locale, 'table.suitedFor')}>{r.suitedFor}</td>
            </tr>
          ))}
        </tbody>
      ))}
    </table>
  </div>
</Section>

<style>
  /* Tờ đặc tả, không phải bảng dữ liệu.
     Bản trước: hộp bo góc, hàng sọc xen kẽ, header navy đặc — ngôn ngữ của
     trang quản trị. Nay chỉ còn gạch tóc ngang, nhiều khoảng trống, tên hoạt
     chất lớn, và NỒNG ĐỘ tách ra đặt bằng face dành cho chữ số. */
  .scroll { overflow-x: auto; }
  .scroll:focus-visible { outline: 3px solid var(--cobalt); outline-offset: 4px; }

  table { width: 100%; border-collapse: collapse; min-width: 720px; }
  caption {
    text-align: left; padding: 0 0 var(--s-5);
    color: var(--slate); font-size: var(--t-xs); max-width: 62ch;
  }
  thead th {
    font-size: var(--t-2xs); font-weight: 600;
    letter-spacing: .18em; text-transform: uppercase;
    color: var(--slate);
    padding: 0 var(--s-5) var(--s-3) 0;
    text-align: left; vertical-align: bottom;
    border-bottom: 1px solid var(--ink-navy);
    background: transparent;
  }
  tbody th, tbody td {
    padding: var(--s-5) var(--s-5) var(--s-5) 0;
    text-align: left; vertical-align: top;
    border-bottom: 1px solid var(--line);
    font-size: var(--t-sm); line-height: 1.55;
    color: var(--ink-muted);
    font-weight: 400;
  }
  tbody tr:last-child :is(th, td) { border-bottom: 0; }
  tbody th { width: 34%; }

  /* Tiêu đề nhóm: một dòng đặc tả, không phải một dải nền màu.
     Gạch tóc đậm hơn một cấp + chữ in hoa nhỏ là đủ để mắt thấy ranh giới
     nhóm mà không cần hộp hay nền. */
  tr.group th {
    padding: var(--s-6) 0 var(--s-3);
    border-bottom: 1px solid var(--line-strong);
    font-size: var(--t-2xs);
    font-weight: 600;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--ink-navy);
  }
  tbody:first-of-type tr.group th { padding-top: var(--s-4); }
  .group-count {
    margin-left: var(--s-3);
    color: var(--slate);
    letter-spacing: .12em;
  }

  .name {
    display: block;
    font-size: var(--t-md);
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--ink-navy);
    font-weight: 600;
    margin-bottom: var(--s-2);
  }
  /* Nồng độ tách khỏi tên và đặt bằng face chữ số — chi tiết chỉ sản phẩm này
     mới có, vì nó là thứ duy nhất nó thật sự công khai. */
  .pct {
    font-family: var(--font-figure);
    font-variant-numeric: tabular-nums lining-nums;
    color: var(--cobalt);
    font-weight: 600;
    white-space: nowrap;
  }
  .ref {
    font-size: var(--t-2xs); letter-spacing: .1em; text-transform: uppercase;
    color: var(--slate); text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
    display: inline-block; min-height: 24px; line-height: 24px;
  }
  .ref:hover { color: var(--cobalt); border-color: currentColor; }
  .ref-note {
    display: block; margin-top: var(--s-2);
    font-size: var(--t-2xs); color: var(--slate); line-height: 1.5;
  }

  /*
   * Dưới 760px bảng KHÔNG còn là bảng.
   *
   * Ảnh chụp màn hình 390px cho thấy bản cũ tràn ngang: cột "vai trò" bị cắt
   * giữa chữ, cột cuối không với tới được, và chú thích bên trên cũng trôi
   * theo vùng cuộn. Bảng thành phần là bằng chứng trung tâm của cả trang, mà
   * phần lớn khách vào bằng điện thoại — nên ở khổ hẹp mỗi hoạt chất thành
   * một thẻ xếp dọc, nhãn cột lấy từ data-label, không nhân đôi nội dung.
   */
  @media (max-width: 760px) {
    .scroll { overflow-x: visible; }
    table { min-width: 0; display: block; }
    thead {
      position: absolute; width: 1px; height: 1px;
      margin: -1px; padding: 0; overflow: hidden;
      clip: rect(0 0 0 0); white-space: nowrap; border: 0;
    }
    caption { display: block; }
    tbody, tbody tr, tbody th, tbody td { display: block; width: auto; }
    /* 24px trên + 24px dưới mỗi dòng = 576px thuần khoảng trắng cho 12 dòng,
       tức 0,68 màn hình điện thoại. Hạ xuống 16px vẫn giữ được nhịp thở giữa
       hai hoạt chất, vì ranh giới đã có gạch tóc và nhóm đã có tiêu đề —
       khoảng trắng không còn phải gánh một mình việc phân tách. */
    tbody tr {
      padding-block: var(--s-4);
      border-bottom: 1px solid var(--line);
    }
    tbody:last-of-type tr:last-child { border-bottom: 0; }
    tbody th, tbody td { padding: 0; border: 0; }
    tbody td { margin-top: var(--s-2); }

    /* Nhóm ở khổ hẹp: vẫn là một hàng, nhưng đọc như một nhãn mục. */
    tbody tr.group { padding-block: var(--s-5) 0; border-bottom: 0; }
    tbody:first-of-type tr.group { padding-top: 0; }
    tr.group th { padding: 0 0 var(--s-3); }
    /* Nhãn cột đi kèm từng ô, vì không còn hàng tiêu đề để đối chiếu. Ô "có
       trong" không cần nhãn: nó đã là một nhãn tròn ghi rõ Serum hay Kem. */
    /* Nhãn ĐI CÙNG HÀNG với giá trị, không chiếm một dòng riêng.
       Mỗi nhãn xuống dòng riêng tốn ~17px; hai nhãn mỗi dòng, mười hai dòng
       là hơn 400px — gần nửa màn hình điện thoại chỉ để in hai chữ lặp lại
       mười hai lần. Đặt cùng hàng vẫn giữ nguyên quan hệ nhãn–giá trị cho
       trình đọc màn hình, vì nhãn vẫn là nội dung thật đứng trước giá trị. */
    tbody td[data-label]::before {
      content: attr(data-label);
      display: inline;
      margin-right: .55em;
      font-size: var(--t-2xs); letter-spacing: .14em; text-transform: uppercase;
      color: var(--slate); font-weight: 600;
      /* Nhãn không được tách khỏi chữ đầu của giá trị khi xuống dòng. */
      white-space: nowrap;
    }
    /* Nhãn tròn "có trong" đã GỠ: thông tin đó nay nằm ở tiêu đề nhóm, nên
       giữ lại nhãn là in cùng một dữ kiện hai lần — đúng thứ vừa sửa. */
  }
</style>
