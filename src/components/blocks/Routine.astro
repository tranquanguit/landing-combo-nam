---
import Section from '../Section.astro';
import { richText } from '../../lib/richtext';

interface Step { label: string; note?: string; essential?: boolean }
interface Col { when: 'morning' | 'night'; label: string; steps: Step[] }
interface Props {
  data: { eyebrow?: string; heading: string; intro?: string; columns: Col[]; footnote?: string };
  id?: string;
}
const { data, id } = Astro.props;
---
<Section id={id} surface="bone" eyebrow={data.eyebrow} heading={data.heading}>
  {data.intro && <p class="rt-intro" set:html={richText(data.intro)} />}

  <div class="rt">
    {data.columns.map((col) => (
      <section class={`rt-col rt-${col.when}`}>
        <h3 class="rt-head">
          {/* Dấu sáng/tối vẽ bằng CSS, không dùng emoji: emoji đổi hình theo hệ
              điều hành và được trình đọc màn hình đọc thành một câu dài. */}
          <span class="rt-mark" aria-hidden="true"></span>
          {col.label}
        </h3>
        <ol class="rt-steps">
          {col.steps.map((s) => (
            <li class={s.essential ? 'is-key' : undefined}>
              <span class="rt-label">{s.label}</span>
              {s.note && <span class="rt-note">{s.note}</span>}
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>

  {data.footnote && <p class="rt-foot" set:html={richText(data.footnote)} />}
</Section>

<style>
  .rt-intro { max-width: 62ch; margin: 0 0 var(--s-6); color: var(--ink-muted); }

  .rt { display: grid; gap: var(--s-5); }
  @media (min-width: 720px) { .rt { grid-template-columns: 1fr 1fr; gap: var(--s-6); } }

  .rt-col {
    background: var(--paper); border: 1px solid var(--line);
    border-radius: 14px; padding: var(--s-5);
  }

  .rt-head {
    display: flex; align-items: center; gap: .6em;
    margin: 0 0 var(--s-5); font-size: var(--t-base);
    letter-spacing: .06em; text-transform: uppercase; color: var(--ink-navy);
  }
  /* Sáng: đĩa đặc. Tối: đĩa khuyết. Hai hình phân biệt được cả khi in đen
     trắng và cả với người không phân biệt được màu. */
  .rt-mark {
    width: 15px; height: 15px; border-radius: 50%; flex: 0 0 auto;
    background: var(--cobalt);
  }
  .rt-night .rt-mark {
    background: transparent; border: 2px solid var(--ink-navy);
    box-shadow: inset -4px 0 0 0 var(--ink-navy);
  }

  .rt-steps { margin: 0; padding: 0; list-style: none; counter-reset: rt; }
  .rt-steps li {
    counter-increment: rt; position: relative;
    padding: 0 0 var(--s-5) 2.6rem;
  }
  .rt-steps li::before {
    content: counter(rt);
    position: absolute; left: 0; top: -1px;
    width: 1.75rem; height: 1.75rem; border-radius: 50%;
    display: grid; place-items: center;
    font-family: var(--font-figure); font-size: var(--t-xs); line-height: 1;
    background: var(--bone); color: var(--ink-navy); border: 1px solid var(--line);
  }
  /* Đường nối giữa các bước — cho thấy đây là một chuỗi, không phải danh sách
     rời rạc muốn làm cái nào trước cũng được. */
  .rt-steps li::after {
    content: ""; position: absolute; left: calc(0.875rem - .5px); top: 1.85rem; bottom: .35rem;
    width: 1px; background: var(--line);
  }
  .rt-steps li:last-child { padding-bottom: 0; }
  .rt-steps li:last-child::after { display: none; }

  .rt-label { display: block; font-weight: 600; color: var(--ink); }
  .rt-note { display: block; margin-top: 3px; font-size: var(--t-sm); color: var(--ink-muted); line-height: 1.6; }

  /* Bước không được bỏ: viền đặc và chữ đậm hơn, kèm chữ "bắt buộc" trong
     `note` chứ không chỉ dựa vào màu. */
  .rt-steps li.is-key::before {
    background: var(--cobalt); color: #fff; border-color: var(--cobalt);
  }
  .rt-steps li.is-key .rt-label { color: var(--ink-navy); }

  .rt-foot {
    margin: var(--s-6) 0 0; max-width: 62ch;
    color: var(--ink-muted); font-size: var(--t-sm); line-height: 1.7;
  }
</style>
