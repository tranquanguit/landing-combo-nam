---
import { t, type Locale } from '../i18n/ui';
/* `product` chỉ có trên trang sản phẩm. Trang chủ, trang dòng và bài viết vẫn
   cần chân trang pháp lý của doanh nghiệp, nhưng không có sản phẩm nào để khai
   số công bố hay công dụng — khai bừa một sản phẩm ở đó là sai thông tin. */
interface Props {
  brand: any; product?: any; locale: Locale;
  /** Cùng danh sách với điều hướng ở đầu trang — trên điện thoại đây là lối đi duy nhất. */
  nav?: { label: string; href: string }[];
  /** Trang chính sách đã xuất bản. Rỗng thì chân trang tự hiện cảnh báo còn thiếu. */
  policies?: { label: string; href: string }[];
}
const { brand: b, product: p, locale, nav = [], policies = [] } = Astro.props;
const c = p?.compliance;
---
<footer>
  <div class="wrap grid">
    {p && c && (
    <div>
      <h2>{t(locale, 'footer.product')}</h2>
      <p>
        <strong>{p.name}</strong><br />
        {t(locale, 'footer.functions')}: {c.functions}<br />
        {t(locale, 'footer.declaredBy')}: {c.declaringOrganization}, {c.declaringAddress}
      </p>
      {c.productNotificationNumber
        ? <p>{t(locale, 'legal.notifNumber')}: <strong>{c.productNotificationNumber}</strong></p>
        : <p class="todo">⚠️ {t(locale, 'todo')}: {t(locale, 'legal.notifNumber')} — {t(locale, 'legal.decree')}.</p>}
      {!b.taxId && <p class="todo">⚠️ {t(locale, 'todo')}: {t(locale, 'legal.taxId')}.</p>}
    </div>
    )}

    {c && (
    <div>
      <h2>{t(locale, 'footer.warning')}</h2>
      <ul class="warnings">
        {c.warnings.map((w: string) => <li>{w}</li>)}
      </ul>
    </div>
    )}

    {nav.length > 0 && (
    <div>
      <h2>{t(locale, 'nav.lines')}</h2>
      <ul class="channels">
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>
    )}

    <div>
      <h2>{t(locale, 'footer.contact')}</h2>
      <p>
        {b.legalName}<br />
        {/* Mã số thuế hiện ngay dưới tên pháp nhân: trước đây nó chỉ nằm trong
            JSON-LD, tức chỉ máy đọc được. Người mua Việt Nam — và cả bên duyệt
            quảng cáo — tra mã số thuế bằng mắt, ngay ở chân trang. */}
        {b.taxId && <>{t(locale, 'legal.taxId')}: {b.taxId}<br /></>}
        {b.address}<br />
        <a href={`tel:${b.phone}`}>{b.phoneDisplay}</a><br />
        <a href={`mailto:${b.email}`}>{b.email}</a><br />
        {t(locale, 'footer.hours')}: {b.hours}
      </p>
      {policies.length > 0 ? (
        <>
          <h3 style="margin-top:1.4em">{t(locale, 'footer.policies')}</h3>
          <ul class="channels">
            {policies.map((x) => <li><a href={x.href}>{x.label}</a></li>)}
          </ul>
        </>
      ) : (
        <p class="todo">⚠️ {t(locale, 'todo')}: {t(locale, 'legal.policies')}.</p>
      )}

      {b.profiles?.length > 0 && (
        <>
          <h3 style="margin-top:1.4em">{t(locale, 'footer.profiles')}</h3>
          <ul class="channels">
            {b.profiles.map((p: any) => (
              <li><a href={p.url} rel="noopener me" target="_blank">{p.name}</a></li>
            ))}
          </ul>
        </>
      )}

      {b.marketplaces.length > 0 && (
        <>
          <h3 style="margin-top:1.4em">{t(locale, 'footer.official')}</h3>
          <ul class="channels">
            {b.marketplaces.map((m: any) => (
              <li>{m.url ? <a href={m.url} rel="noopener">{m.name}</a> : <span>{m.name}</span>}</li>
            ))}
          </ul>
          {b.marketplaces.some((m: any) => !m.url) && (
            <p class="todo">⚠️ {t(locale, 'todo')}: {t(locale, 'legal.storeLinks')}</p>
          )}
        </>
      )}
    </div>
  </div>

  <div class="wrap bottom">
    <span>© {new Date().getFullYear()} {b.legalName}</span>
    <button type="button" id="withdraw-consent" class="linky" hidden>
      {t(locale, 'consent.withdraw')}
    </button>
    <button type="button" id="reset-consent" class="linky" hidden>
      {t(locale, 'consent.reconsider')}
    </button>
  </div>

  <script>
    const withdraw = document.getElementById('withdraw-consent');
    const reset = document.getElementById('reset-consent');
    try {
      const decision = localStorage.getItem('mocha_analytics_consent');
      if (decision === 'yes' && withdraw) {
        withdraw.hidden = false;
        withdraw.addEventListener('click', () => (window as any).mochaWithdrawConsent?.());
      }
      /* Đã từ chối: cho đường quay lại, nếu không thì từ chối là quyết định
         không thể đảo ngược — cũng là một dạng không tôn trọng lựa chọn. */
      if (decision === 'no' && reset) {
        reset.hidden = false;
        reset.addEventListener('click', () => (window as any).mochaResetConsent?.());
      }
    } catch { /* chế độ riêng tư: không có gì để rút */ }
  </script>
</footer>

<style>
  footer { background: var(--ink); color: rgba(255, 255, 255, .74); padding-block: var(--s-7) var(--s-6); font-size: var(--t-sm); }
  footer :is(h2, h3) { color: #fff; font-size: var(--t-base); font-family: var(--font-body); font-weight: 600; }
  footer a { color: #b9c0ff; display: inline-block; min-height: 24px; line-height: 24px; }
  .grid { display: grid; gap: var(--s-6); }
  @media (min-width: 800px) { .grid { grid-template-columns: 1.3fr 1fr 1fr; } }
  .warnings { padding-left: 1.1em; margin: 0; display: grid; gap: var(--s-2); }
  .channels { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-4); }
  .linky { background: none; border: 0; padding: 0; font: inherit; color: #9fc0ff; text-decoration: underline; cursor: pointer; min-height: 24px; }
  .bottom { border-top: 1px solid rgba(255, 255, 255, .12); margin-top: var(--s-6); padding-top: var(--s-4); font-size: var(--t-xs); }
</style>
