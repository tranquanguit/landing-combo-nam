---
interface Props {
  id?: string;
  surface?: 'bone' | 'paper' | 'mist' | 'navy';
  eyebrow?: string;
  heading?: string;
  intro?: string;
  center?: boolean;
  /** Khối đầu trang không được defer, nếu không sẽ ảnh hưởng LCP. */
  aboveFold?: boolean;
}
const { id, surface = 'bone', eyebrow, heading, intro, center = false, aboveFold = false } = Astro.props;
const surfaceClass = surface === 'bone' ? '' : `surface-${surface}`;
const headingId = id ? `${id}-title` : undefined;
---
<section
  id={id}
  class:list={[surfaceClass, !aboveFold && 'defer']}
  aria-labelledby={headingId}
  data-reveal-group
>
  <div class="wrap">
    {heading && (
      <div class:list={['section-head', center ? 'center' : 'split-head']} data-reveal>
        <div class="head-title">
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          <h2 id={headingId}>{heading}</h2>
        </div>
        {intro && <p class="lead">{intro}</p>}
      </div>
    )}
    <div data-reveal><slot /></div>
  </div>
</section>
