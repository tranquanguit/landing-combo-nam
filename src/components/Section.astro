---
interface Props {
  id?: string;
  surface?: 'bone' | 'paper' | 'mist' | 'navy';
  eyebrow?: string;
  heading?: string;
  intro?: string;
  center?: boolean;
  /** Khối đầu trang không được defer, nếu không sẽ ảnh hưởng LCP. */
  aboveFold?: boolean;
  /** Nhịp dọc. Bỏ trống là 'md' — đúng giá trị dùng chung trước đây. */
  space?: 'sm' | 'md' | 'lg';
  /** Khối ngay trên có cùng màu nền: bỏ đệm trên để hai khối thành một cụm. */
  sameSurface?: boolean;
  /**
   * Vai của khối trong câu chuyện.
   *
   * Phát ra `data-narrative-role` trên thẻ <section>. Không có tác dụng thị
   * giác nào: nó tồn tại để trình tự kể chuyện ĐỌC ĐƯỢC từ HTML đã dựng, nên
   * cổng `tests/narrative.mjs` kiểm được trang thật thay vì kiểm lại file JSON
   * mà nó vừa đọc — kiểm dữ liệu đầu vào bằng chính dữ liệu đầu vào thì không
   * chứng minh được gì về trang.
   */
  role?: string;
  /**
   * Câu nối sang khối kế tiếp, in ở cuối khối.
   *
   * Không phải một khối riêng: nó là một dòng dẫn, và chỉ hiện khi file nội
   * dung thật sự khai. Đặt ở mọi khối thì nó thành nhiễu.
   */
  transition?: string;
  /** Lời mời hành động ở cuối khối. Xem `cta` trong schema. */
  cta?: { note?: string; label: string; href: string };
  /**
   * Khối này là ĐÍCH của một liên kết neo.
   *
   * `tabindex="-1"` để trình duyệt tự chuyển focus vào đây khi người dùng nhảy
   * tới neo — nếu không, bàn phím và trình đọc màn hình vẫn đứng ở chỗ cũ trong
   * khi màn hình đã cuộn đi, và người dùng mất dấu mình đang ở đâu.
   *
   * Làm bằng thuộc tính chuẩn thay vì JS: ngân sách JS nội tuyến của trang chỉ
   * còn hơn trăm byte, và đây là việc trình duyệt vốn đã làm đúng.
   */
  focusTarget?: boolean;
}
const {
  id, surface = 'bone', eyebrow, heading, intro,
  center = false, aboveFold = false, space, sameSurface = false,
  role, transition, cta, focusTarget = false,
} = Astro.props;
const surfaceClass = surface === 'bone' ? '' : `surface-${surface}`;
const headingId = id ? `${id}-title` : undefined;
---
<section
  id={id}
  class:list={[surfaceClass, !aboveFold && 'defer', space && `space-${space}`, sameSurface && 'same-surface']}
  aria-labelledby={headingId}
  tabindex={focusTarget ? -1 : undefined}
  data-narrative-role={role}
  data-reveal-group
>
  <div class="wrap">
    {heading && (
      <div class:list={['section-head', center ? 'center' : 'split-head']} data-reveal>
        <div class="head-title">
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          <h2 id={headingId}>{heading}</h2>
        </div>
        {intro && <p class="lead">{intro}</p>}
      </div>
    )}
    <div data-reveal><slot /></div>
    {cta && (
      <div class="sec-cta" data-reveal>
        {cta.note && <p class="sec-cta-note">{cta.note}</p>}
        <a class="sec-cta-link" href={cta.href} data-cta={`inline-${role ?? 'section'}`}>{cta.label}</a>
      </div>
    )}
    {transition && (
      <p class="transition" data-reveal>{transition}</p>
    )}
  </div>
</section>

<style>
  /* Dòng nối: đọc như lời dẫn của người biên tập, không như một tiêu đề phụ.
     Căn theo mép trái của nội dung và giới hạn độ dài dòng, vì nó là một CÂU
     chứ không phải một nhãn. */
  .transition {
    margin: clamp(32px, 4vw, 56px) 0 0;
    max-width: 46ch;
    font-size: var(--t-md);
    line-height: 1.5;
    color: var(--ink-muted);
    text-wrap: pretty;
  }
  /* CTA trong thân trang KHÔNG phải nút khối đặc như ở hero.
     Hero là chỗ mời; ở đây là chỗ người đọc vừa tự kết luận, nên hình thái
     đúng là một câu nói có đường dẫn, đặt trong nhịp của tờ đặc tả — không
     phải một khối màu chen ngang mạch đọc. */
  /* Đích cuộn nhận focus để không mất dấu, nhưng KHÔNG vẽ vòng focus:
     nó là một vùng nội dung, không phải một control bấm được. */
  section[tabindex="-1"]:focus { outline: none; }

  .sec-cta {
    margin-top: clamp(32px, 4vw, 56px);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
    max-width: 46ch;
  }
  .sec-cta-note {
    margin: 0 0 var(--s-3);
    font-size: var(--t-base);
    line-height: 1.55;
    color: var(--ink-muted);
    text-wrap: pretty;
  }
  .sec-cta-link {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    /* 44px là ngưỡng vùng chạm thoải mái trên điện thoại; 24px của WCAG là
       mức tối thiểu, không phải mức nên nhắm tới cho một đường chốt đơn. */
    min-height: 44px;
    font-weight: 600;
    font-size: var(--t-base);
    color: var(--ink-navy);
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
    transition: color var(--dur-2) var(--ease), border-color var(--dur-2) var(--ease);
  }
  .sec-cta-link::after {
    content: "\2193";           /* mũi tên xuống: đích nằm phía dưới trang */
    font-size: .9em;
    line-height: 1;
  }
  .sec-cta-link:hover {
    color: var(--cobalt);
    border-bottom-color: var(--cobalt);
  }
  /* Trên nền đậm (khối ưu đãi/đặt hàng) giữ đủ tương phản. */
  .surface-navy .sec-cta-note:not(.on-light *) { color: rgba(255, 255, 255, .82); }
  .surface-navy .sec-cta-link:not(.on-light *) { color: #fff; border-bottom-color: rgba(255, 255, 255, .5); }

  .transition::before {
    content: "";
    display: block;
    width: 28px;
    height: 1px;
    background: var(--line-strong);
    margin-bottom: var(--s-4);
  }
</style>
