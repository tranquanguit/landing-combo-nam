---
import Picture from './Picture.astro';
import { money } from '../lib/format';
import { comboPath, productPath } from '../lib/routes';
import { t, type Locale } from '../i18n/ui';

/**
 * Lưới thẻ combo — cùng hệ thị giác với ProductGrid (khay ảnh nền trắng, gạch tóc
 * phía trên, cả thẻ là một liên kết), thêm giá mua lẻ gạch ngang và mức tiết kiệm.
 * Hai con số đó đã TÍNH sẵn (src/lib/combos.ts), thẻ chỉ in ra.
 *
 * `cards`: { slug, name, shortName, image, imageAlt, price, regular, pct, count, product? }
 * `product: true` = thẻ trỏ về một trang SẢN PHẨM dạng bộ (Combo Nám, bộ peel) thay vì trang combo.
 */
interface Props { cards: any[]; locale: Locale; source?: string; priority?: boolean }
const { cards, locale, source, priority = false } = Astro.props;
---
<ul class="grid" data-reveal-group>
  {cards.map((c, i) => (
    <li data-reveal>
      <a href={c.product ? productPath(c.slug, locale) : comboPath(c.slug, locale)}
         data-cta={source ? `${source}-combo` : undefined}
         data-cta-kind={source ? 'select' : undefined}>
        <span class="shot">
          <Picture src={c.image} alt={c.imageAlt ?? c.name} ratio="4/3" fit={c.product ? 'contain' : 'cover'}
            sizes="(min-width: 760px) 280px, 46vw" widths={[360]}
            loading={priority && i === 0 ? 'eager' : 'lazy'} fetchpriority={priority && i === 0 ? 'high' : 'auto'} />
        </span>
        <span class="name">{c.shortName ?? c.name}</span>
        {c.count > 1 && <span class="count">{t(locale, 'combo.count').replace('{n}', String(c.count))}</span>}
        <span class="foot">
          <span class="price figure">{money(c.price, 'VND', locale)}</span>
          {c.regular > c.price && <s class="was figure"><span class="sr-only">{t(locale, 'combo.regular')} </span>{money(c.regular, 'VND', locale)}</s>}
          {c.pct > 0 && <span class="off figure">−{c.pct}%</span>}
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .grid {
    list-style: none; padding: 0; margin: 0;
    display: grid; gap: var(--s-6) var(--s-5);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
  }
  a {
    display: grid; gap: var(--s-2); align-content: start;
    height: 100%; text-decoration: none; color: inherit;
    border-top: 1px solid var(--line-strong); padding-top: var(--s-4);
  }
  a:hover .name { color: var(--cobalt); }
  .shot { position: relative; display: block; background: #fff; overflow: hidden; border: 1px solid var(--line); margin-bottom: var(--s-2); }
  .shot :global(img) { width: 100%; display: block; transition: transform 620ms var(--ease-out); }
  @media (hover: hover) { a:hover .shot :global(img) { transform: scale(1.035); } }
  /* Nhãn % đứng cạnh giá, KHÔNG đè lên ảnh: ảnh sản phẩm phải nhìn thấy trọn. */
  .off {
    padding: 2px 9px; border-radius: 999px;
    background: var(--verify); color: #fff; font-size: var(--t-xs); font-weight: 600;
  }
  .name { font-size: var(--t-md); font-weight: 600; line-height: 1.25; letter-spacing: -0.015em; color: var(--ink-navy); }
  .count { font-size: var(--t-sm); color: var(--slate); }
  .foot { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-3); align-items: baseline; margin-top: auto; padding-top: var(--s-1); }
  .price { font-weight: 600; color: var(--ink-navy); font-size: var(--t-base); }
  .was { color: var(--slate); font-size: var(--t-sm); }
  /* Điện thoại: hai cột. Một cột thì mỗi thẻ cao nửa màn hình và trang danh sách
     ba mươi combo dài gần hai mươi màn hình. */
  @media (max-width: 599px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-5) var(--s-3); }
    .name { font-size: var(--t-sm); }
    .count { font-size: var(--t-xs); }
    .price { font-size: var(--t-sm); }
    .was { font-size: var(--t-xs); }
  }
</style>
