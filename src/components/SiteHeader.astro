---
import { t, type Locale } from '../i18n/ui';
import Picture from '../components/Picture.astro';
import LocaleSwitcher from './LocaleSwitcher.astro';
import { localePath } from '../i18n/ui';
interface Props {
  brand: any; locale: Locale; alternates?: { locale: Locale; url: string }[];
  /**
   * Nút đặt mua trỏ đi đâu. Trên landing là neo #dat-hang trong chính trang;
   * trên trang chủ, trang dòng và bài viết thì KHÔNG có neo đó — để mặc định
   * sẽ thành một nút chết trên ba phần tư số trang của site.
   */
  orderHref?: string;
  /** Điều hướng chính. Sinh từ dữ liệu ở route, không viết cứng ở đây. */
  nav?: { label: string; href: string }[];
}
const { brand: b, locale, alternates = [], orderHref = '#dat-hang', nav = [] } = Astro.props;

/** Danh sách phẳng -> từng nhóm có tiêu đề là tên dòng. */
function groupChildren(children: { label: string; href: string; note?: string }[]) {
  const groups: { label: string; href: string; items: { label: string; href: string }[] }[] = [];
  for (const c of children) {
    if (c.note === 'line') groups.push({ label: c.label, href: c.href, items: [] });
    else groups[groups.length - 1]?.items.push(c);
  }
  return groups;
}
---
<header>
  <div class="wrap bar">
    {/* Logo phải về trang chủ. Trước đây là href="#main", tức một skip-link thứ
        hai: từ trang sản phẩm phụ chỉ còn breadcrumb là đường về. */}
    <a class="brand" href={localePath(locale, '/')} aria-label={b.tradingName}>
      <Picture src={b.logo} alt={b.tradingName} width={92} height={34}
        sizes="92px" widths={[92, 184]} loading="eager" />
    </a>
    {nav.length > 0 && (
      <nav class="nav" aria-label={b.tradingName}>
        <ul>
          {nav.map((item) => (
            <li class={item.children?.length ? 'has-panel' : undefined}>
              <a href={item.href}>
                {item.label}
                {item.children?.length ? <span class="caret" aria-hidden="true"></span> : null}
              </a>
              {item.children?.length ? (
                /* Bảng danh mục mở bằng :hover và :focus-within — không JavaScript.
                   Mọi liên kết trong bảng đều là <a> thật và nằm trong DOM ngay từ
                   đầu, nên máy tìm kiếm thấy hết, và bàn phím Tab đi qua được.

                   Mỗi dòng sản phẩm là MỘT <ul> riêng, không phải một danh sách
                   phẳng chia cột bằng `grid-auto-flow: column`. Bản trước làm thế
                   và cột bị cắt ngang giữa nhóm: tên dòng rơi xuống cuối cột này
                   còn sản phẩm của nó nằm đầu cột kia. */
                <div class="panel">
                  <div class="panel-cols">
                    {groupChildren(item.children).map((g) => (
                      <ul class="panel-group">
                        <li class="is-line"><a href={g.href}>{g.label}</a></li>
                        {g.items.map((c) => (
                          <li class="is-product"><a href={c.href}>{c.label}</a></li>
                        ))}
                      </ul>
                    ))}
                  </div>
                </div>
              ) : null}
            </li>
          ))}
        </ul>
      </nav>
    )}
    <div class="actions">
      <LocaleSwitcher current={locale} alternates={alternates} />
      <a class="tel" href={`tel:${b.phone}`} data-cta="header-call">{b.phoneDisplay}</a>
      <a class="btn btn-primary compact" href={orderHref} data-cta="header-order">{t(locale, 'nav.order')}</a>
    </div>
  </div>
</header>

<style>
  header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(247, 245, 242, .94);
    backdrop-filter: saturate(180%) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--s-4);
    /* Chiều cao cố định, không phải min-height: header không được co giãn
       khi font tải xong, nếu không cả trang bị đẩy xuống. */
    height: var(--header-h);
  }
  .brand :global(img) { height: 30px; width: auto; object-fit: contain; }

  /* Điều hướng ẩn dưới 860px: trên điện thoại, thanh trên cùng ưu tiên hotline
     và nút đặt mua. Các đường dẫn này vẫn có trong chân trang và trong nội dung
     trang, nên không có trang nào mất đường vào. */
  .nav { display: none; }
  @media (min-width: 860px) {
    .nav { display: block; margin-inline: auto; }
    /* `> ul` chứ không phải ` ul`: bảng danh mục cũng là <ul> nằm trong .nav,
       nên bộ chọn con cháu biến nó thành một hàng ngang và mỗi tên sản phẩm co
       lại thành một cột chữ dọc một ký tự. */
    .nav > ul { list-style: none; display: flex; gap: var(--s-5); margin: 0; padding: 0; }
    .nav a { color: var(--ink-muted); text-decoration: none; font-size: var(--t-sm); }
    .nav > ul > li > a { display: inline-block; min-height: 24px; line-height: 24px; }
    .nav > ul > li > a:hover { color: var(--cobalt); }

    /* Mục có bảng: dấu mũi tên nhỏ báo trước rằng bấm vào sẽ mở ra thêm. Không
       có dấu này thì người dùng không biết có gì bên dưới và bảng chỉ bật ra
       khi chuột đi ngang qua — một cú giật không ai yêu cầu. */
    .caret {
      display: inline-block; width: 0; height: 0; margin-left: 6px;
      vertical-align: middle;
      border-inline: 4px solid transparent;
      border-top: 4px solid currentColor;
      transition: transform var(--dur-1) var(--ease);
    }
    .has-panel { position: relative; }
    .has-panel > a { display: inline-flex; align-items: center; }
    .has-panel:hover .caret,
    .has-panel:focus-within .caret { transform: rotate(180deg); }

    .panel {
      position: absolute; top: 100%;
      /* Neo theo mép trái của mục, KHÔNG căn giữa. Mục "Sản phẩm" nằm gần mép
         trái màn hình, nên một bảng rộng căn giữa sẽ tràn ra ngoài khung nhìn —
         đúng lỗi ở ảnh chụp: ba nhóm cuối bị cắt mất một nửa. */
      left: 0;
      padding-top: 10px;
      opacity: 0; visibility: hidden; transform: translateY(-6px);
      transition: opacity var(--dur-2) var(--ease), transform var(--dur-2) var(--ease),
        visibility 0s linear var(--dur-2);
    }
    .has-panel:hover .panel,
    .has-panel:focus-within .panel {
      opacity: 1; visibility: visible; transform: none;
      transition-delay: 0s;
    }

    .panel-cols {
      display: grid; grid-template-columns: repeat(3, minmax(11rem, 13rem));
      gap: var(--s-5) var(--s-6);
      /* Căn đỉnh: ba nhóm có số sản phẩm khác nhau, để `stretch` thì nhóm một
         sản phẩm bị kéo cao bằng nhóm ba sản phẩm và khoảng trắng dồn vào giữa. */
      align-items: start;
      padding: var(--s-5) var(--s-6);
      background: var(--paper); border: 1px solid var(--line);
      border-radius: 14px; box-shadow: 0 18px 44px -18px rgba(16, 24, 64, .28);
    }

    .panel-group { margin: 0; padding: 0; list-style: none; }
    .panel-group a { display: block; padding: 5px 0; line-height: 1.35; }

    /* Tên dòng là tiêu đề của nhóm; sản phẩm thụt vào dưới nó. Phân cấp bằng
       cỡ chữ và độ đậm, không bằng màu — bảng này đã có đủ màu rồi. */
    .panel-group .is-line > a {
      font-weight: 600; font-size: var(--t-xs); letter-spacing: .08em;
      text-transform: uppercase; color: var(--ink-navy);
      padding-bottom: var(--s-3);
    }
    .panel-group .is-product > a {
      padding-left: var(--s-3); font-size: var(--t-sm); color: var(--ink-muted);
      border-left: 2px solid var(--line);
      /* Tên sản phẩm dài thì xuống dòng trong cột của nó, không đẩy cột rộng ra. */
      overflow-wrap: anywhere;
    }
    .panel-group .is-product > a:hover {
      color: var(--cobalt); border-left-color: var(--cobalt);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel, .caret { transition: none; }
  }
  .actions { display: flex; align-items: center; gap: var(--s-4); }
  .tel {
    display: none; font-weight: 600; font-size: var(--t-sm);
    color: var(--ink-navy); text-decoration: none;
    min-height: 24px; align-items: center;
  }
  @media (min-width: 620px) { .tel { display: inline-flex; } }
  .compact { padding: 9px 18px; font-size: var(--t-sm); }
</style>
