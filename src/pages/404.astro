---
import { getCollection, getEntry } from 'astro:content';
import { homePath, linePath, policyPath, productPath, siteNav } from '../lib/routes';
import SiteHeader from '../components/SiteHeader.astro';
import { t, type Locale } from '../i18n/ui';
import '../styles/fonts.css';
import '../styles/tokens.css';

/**
 * Trang 404 dựng từ dữ liệu.
 *
 * Kiểm định lần 6: bản build chỉ có index.html và en/index.html, nên mọi URL sai —
 * kể cả link cũ đã chia sẻ trong quảng cáo — rơi vào trang lỗi mặc định của nhà
 * cung cấp hosting: không header, không hotline, không đường về. Với một trang
 * chạy quảng cáo trả tiền thì đó là tiền đổ ra ngoài.
 */
const brand = await getEntry('brand', 'mocha');
if (!brand) throw new Error('Thiếu src/data/mocha.json');
const b = brand.data;
// Sản phẩm chủ lực nằm ở gốc tên miền nên productPath() trả về "/" — liệt kê
// nó sẽ thành link thứ hai trùng y hệt "Trang chủ".
const all = await getCollection('products', ({ data }) => data.status === 'published');
const pick = (loc: Locale, home: string) => all
  .filter((p) => p.data.locale === loc)
  .filter((p) => productPath(p.data.slug, p.data.locale as Locale) !== home);
const vi = pick('vi', '/');
const en = pick('en', '/en/');

/* Dòng sản phẩm thay cho danh sách phẳng 24 liên kết.

   Bản trước liệt kê THẲNG mọi sản phẩm của cả hai ngôn ngữ: 24 liên kết xếp
   dọc, không nhóm, không thứ tự có nghĩa. Người vừa bấm một quảng cáo và rơi
   vào 404 thì cần một lối đi, không cần một bản kê. Sáu dòng thì đọc hết
   trong vài giây, và từng sản phẩm vẫn tới được qua bảng danh mục ở đầu trang. */
const lines = await getCollection('lines', ({ data }) => data.status === 'published');
const linesOf = (loc: Locale) => lines
  .filter((l) => l.data.locale === loc)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const policies = await getCollection('policies', ({ data }) => data.status === 'published');
const contactSlug = policies.find((x) => x.data.topLevel && x.data.translationKey === 'lien-he')?.data.slug;

/* Thanh điều hướng thật, giống hệt mọi trang khác.

   Bản trước trang 404 không có header, không footer, không menu — người dùng
   chỉ còn một danh sách link trần. Trang lỗi là chỗ người ta đã lạc đường;
   lấy nốt điều hướng của họ đi là đẩy họ ra khỏi site. */
const nav = siteNav(
  'vi',
  linesOf('vi').map((l) => ({
    slug: l.data.slug, heading: l.data.heading,
    navLabel: l.data.navLabel, order: l.data.order,
    products: l.data.products.length
      ? l.data.products
      : all.filter((p) => p.data.line === l.data.slug && p.data.locale === 'vi').map((p) => p.data.slug),
  })),
  true,
  { advice: t('vi', 'nav.advice'), products: t('vi', 'nav.products'), contact: t('vi', 'nav.contact') },
  (slug) => all.find((p) => p.data.slug === slug && p.data.locale === 'vi')?.data.shortName,
  contactSlug,
);
---
<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0e1250" />
    <title>Không tìm thấy trang — {b.tradingName}</title>
    <meta name="robots" content="noindex, follow" />
  </head>
  <body>
    <SiteHeader brand={b} locale="vi" nav={nav} orderHref={homePath('vi')} />
    <main id="main" class="wrap notfound">
      <p class="eyebrow">Lỗi 404</p>
      <h1>Không tìm thấy trang này</h1>
      <p class="lead">
        Đường dẫn bạn mở không còn tồn tại hoặc đã bị gõ sai. Dưới đây là các trang đang hoạt động.
      </p>

      <ul class="links">
        <li><a href={homePath("vi")}>Trang chủ</a></li>
        {linesOf('vi').map((l) => (
          <li><a href={linePath(l.data.slug, 'vi')}>{l.data.heading}</a></li>
        ))}
      </ul>

      {/* Song ngữ trên CÙNG một file: hầu hết nhà cung cấp hosting tĩnh chỉ phục
          vụ 404.html ở gốc, nên một trang /en/404/ riêng sẽ gần như không bao giờ
          được dùng tới. */}
      <hr />
      <h2 lang="en">Page not found</h2>
      <p class="lead" lang="en">
        The link you opened no longer exists or was mistyped. These pages are live:
      </p>
      <ul class="links" lang="en">
        <li><a href={homePath("en")}>Home (English)</a></li>
        {linesOf('en').map((l) => (
          <li><a href={linePath(l.data.slug, 'en')}>{l.data.heading}</a></li>
        ))}
      </ul>

      <p class="lead">
        Cần hỗ trợ ngay: gọi <a href={`tel:${b.phone}`}>{b.phoneDisplay}</a> ({b.hours})
        hoặc gửi email <a href={`mailto:${b.email}`}>{b.email}</a>.
      </p>
      <p class="muted">{b.legalName} — {b.address}</p>
    </main>

    <style>
      .notfound { padding-block: clamp(48px, 8vw, 96px); max-width: 640px; }
      .notfound h1 { margin-block: var(--s-2) var(--s-4); }
      .links { list-style: none; padding: 0; margin: var(--s-5) 0; display: grid; gap: var(--s-3); }
      .links a, .notfound p a { min-height: 24px; display: inline-block; line-height: 24px; }
      hr { border: 0; border-top: 1px solid var(--line); margin-block: var(--s-6); }
      .notfound h2 { font-size: var(--t-lg); margin-block: 0 var(--s-3); }
      .muted { color: var(--ink-muted); font-size: var(--t-sm); margin-top: var(--s-6); }
    </style>
  </body>
</html>
