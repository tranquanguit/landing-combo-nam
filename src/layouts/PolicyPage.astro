---
import { shortDate } from '../lib/format';
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Analytics from '../components/Analytics.astro';
import { breadcrumbNode, organizationNode } from '../lib/schema';
import { resolveAssetImage, resolveAssetUrl } from '../lib/images';
import { homePath, policyPath } from '../lib/routes';
import { assertTranslated, htmlLang, t, type Locale } from '../i18n/ui';
import { richText } from '../lib/richtext';
import Order from '../components/blocks/Order.astro';

interface Props {
  policy: any;
  brand: any;
  locale: Locale;
  canonical: string;
  alternates?: { locale: Locale; url: string }[];
  nav?: { label: string; href: string }[];
  policies?: { label: string; href: string }[];
  pages?: { label: string; href: string }[];
  fallbackOgImage?: string;
}

const { policy: d, brand: b, locale, canonical, alternates = [], nav = [], policies = [], pages = [], fallbackOgImage } = Astro.props;
const site = Astro.site?.origin ?? 'https://mochatrinam.com';
assertTranslated(locale);

const breadcrumb = [
  { name: t(locale, 'nav.home'), url: new URL(homePath(locale), site).href },
  { name: d.title, url: new URL(policyPath(d.slug, locale), site).href },
];
const og = await resolveAssetImage(d.seo.ogImage ?? fallbackOgImage, site, 1200);
const logoUrl = await resolveAssetUrl(b.logo, site, 512);

/* Trang chính sách không cần Article: nó không phải nội dung biên tập, nó là
   điều khoản. WebPage + BreadcrumbList là đủ và đúng. */
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    organizationNode(b, site, locale, logoUrl),
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: d.seo.title,
      description: d.seo.description,
      inLanguage: htmlLang[locale],
      dateModified: d.updatedAt,
      publisher: { '@id': `${site}/#organization` },
    },
    breadcrumbNode(canonical, breadcrumb),
  ],
};

const sections = d.sections.map((s: any, i: number) => ({ ...s, id: s.id ?? `muc-${i + 1}` }));

/* ---- Trang liên hệ: thông tin liên lạc + biểu mẫu nhận tư vấn ---------------------
   Biểu mẫu là ĐÚNG biểu mẫu đặt hàng, chỉ có lựa chọn "tư vấn": cùng một đường gửi,
   cùng một chỗ nhân viên nhận, không thêm hộp thư thứ hai để ai đó quên kiểm. */
const contact = d.contactForm;
const facebook = b.profiles?.find((x: any) => /facebook/i.test(x.name));
const channels = contact ? [
  { k: 'phone', label: t(locale, 'contact.phone'), value: b.phoneDisplay, href: `tel:${b.phone}`, note: b.hours ? `${t(locale, 'footer.hours')}: ${b.hours}` : t(locale, 'contact.always') },
  ...(b.zalo ? [{ k: 'zalo', label: 'Zalo', value: b.phoneDisplay, href: b.zalo, note: t(locale, 'contact.zaloNote'), ext: true }] : []),
  ...(facebook ? [{ k: 'facebook', label: 'Facebook', value: t(locale, 'contact.fbValue'), href: facebook.url, note: t(locale, 'contact.fbNote'), ext: true }] : []),
  { k: 'email', label: 'Email', value: b.email, href: `mailto:${b.email}`, note: t(locale, 'contact.emailNote') },
  { k: 'address', label: t(locale, 'footer.address'), value: b.address },
  ...(b.taxId ? [{ k: 'tax', label: t(locale, 'legal.taxId'), value: b.taxId }] : []),
] : [];
const consultProduct = {
  slug: d.slug, currency: 'VND', price: 0,
  variants: [{ label: t(locale, 'contact.consultPack'), price: null, recommended: true }],
};
const consultData = {
  eyebrow: t(locale, 'contact.formEyebrow'),
  heading: t(locale, 'contact.formHeading'),
  body: t(locale, 'contact.formBody'),
  points: [t(locale, 'contact.point1'), t(locale, 'contact.point2'), t(locale, 'contact.point3')],
};
---
<BaseLayout
  siteName={b.tradingName}
  locale={locale}
  title={d.seo.title}
  description={d.seo.description}
  canonical={canonical}
  ogImage={og?.url}
  ogImageWidth={og?.width}
  ogImageHeight={og?.height}
  ogImageAlt={d.title}
  ogType="website"
  alternates={alternates}
  jsonLd={jsonLd}
>
  <SiteHeader brand={b} locale={locale} alternates={alternates} nav={nav} orderHref={homePath(locale)} />
  <Breadcrumb items={breadcrumb} locale={locale} />

  <main id="main">
    <div class="head">
      <div class="wrap enter">
        <p class="eyebrow">{contact ? t(locale, 'nav.contact') : t(locale, 'policy.heading')}</p>
        <h1>{d.title}</h1>
        <p class="lead" set:html={richText(d.lead)} />
        {!contact && (
          <p class="meta">
            <time datetime={d.updatedAt}>{t(locale, 'policy.updated')} {shortDate(d.updatedAt, locale)}</time>
          </p>
        )}
      </div>
    </div>

    {contact && (
      <div class="wrap">
        <ul class="ch">
          {channels.map((c: any) => (
            <li class={`ch-${c.k}`}>
              <span class="ch-l">{c.label}</span>
              {c.href
                ? <a class="ch-v" href={c.href} {...(c.ext ? { target: '_blank', rel: 'noopener' } : {})} data-cta={`contact-${c.k}`}>{c.value}</a>
                : <span class="ch-v">{c.value}</span>}
              {c.note && <span class="ch-n">{c.note}</span>}
            </li>
          ))}
        </ul>
      </div>
    )}
    {contact && <Order data={consultData} product={consultProduct} brand={b} locale={locale} mode="consult" />}

    {sections.length > 0 && (
    <div class="wrap body">
      <nav class="toc" aria-label={t(locale, 'article.toc')}>
        <h2>{t(locale, 'article.toc')}</h2>
        <ol>{sections.map((s: any) => <li><a href={`#${s.id}`}>{s.heading}</a></li>)}</ol>
      </nav>

      <div class="prose">
        {sections.map((s: any) => (
          <section id={s.id} aria-labelledby={`${s.id}-title`}>
            <h2 id={`${s.id}-title`}>{s.heading}</h2>
            {s.body.map((para: string) => <p set:html={richText(para)} />)}
          </section>
        ))}

        {/* Chỗ còn trống nói ra, không giấu: một chính sách im lặng về phần
            chưa quyết chỉ tạo ra tranh cãi sau này. */}
        {d.pending.length > 0 && (
          <aside class="pending" aria-labelledby="pending-title">
            <h2 id="pending-title">⚠️ {t(locale, 'policy.pending')}</h2>
            <ul>{d.pending.map((x: string) => <li>{x}</li>)}</ul>
          </aside>
        )}
      </div>
    </div>
    )}
  </main>

  <SiteFooter brand={b} locale={locale} nav={nav} policies={policies} pages={pages} />
  <Analytics locale={locale} />
</BaseLayout>

<style>
  .ch {
    list-style: none; padding: 0; margin: 0 0 var(--s-7);
    display: grid; gap: var(--s-4); grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
  }
  .ch li {
    display: grid; gap: 4px; align-content: start; padding: var(--s-4) var(--s-5);
    background: #fff; border: 1px solid var(--line); border-radius: var(--r-card);
  }
  .ch-l { font-size: var(--t-xs); letter-spacing: .08em; text-transform: uppercase; color: var(--slate); }
  .ch-v { font-size: var(--t-base); font-weight: 600; color: var(--ink-navy); line-height: 1.35; overflow-wrap: anywhere; }
  a.ch-v { color: var(--cobalt); text-decoration: none; display: inline-block; min-height: 24px; }
  a.ch-v:hover { text-decoration: underline; }
  .ch-n { font-size: var(--t-sm); color: var(--ink-muted); }
  .ch-phone, .ch-zalo { border-color: var(--line-strong); }
  .head { background: var(--paper); padding-block: var(--s-7) var(--s-5); }
  .head h1 { margin: 0 0 var(--s-4); max-width: 20ch; }
  .head .lead { max-width: 62ch; margin: 0 0 var(--s-4); }
  .meta { margin: 0; font-size: var(--t-xs); color: var(--slate); }

  .body { display: grid; gap: var(--s-6); padding-block: var(--s-6) var(--s-7); }
  @media (min-width: 1000px) {
    .body { grid-template-columns: 16rem minmax(0, 1fr); gap: clamp(40px, 5vw, 80px); }
    .toc { position: sticky; top: calc(var(--header-h) + var(--s-5)); align-self: start; }
  }
  .toc h2 {
    font-size: var(--t-2xs); letter-spacing: .18em; text-transform: uppercase;
    color: var(--slate); margin: 0 0 var(--s-3);
  }
  .toc ol { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--s-2); }
  .toc a {
    color: var(--ink-muted); text-decoration: none; font-size: var(--t-sm);
    display: inline-block; min-height: 24px; line-height: 24px;
  }
  .toc a:hover { color: var(--cobalt); }

  .prose { max-width: var(--measure-prose); }
  .prose section + section { margin-top: var(--s-6); }
  .prose h2 {
    font-size: var(--t-md); letter-spacing: -0.015em;
    margin: 0 0 var(--s-4); scroll-margin-top: calc(var(--header-h) + var(--s-4));
  }
  .prose p { margin: 0 0 var(--s-4); line-height: 1.72; }
  .prose p:last-child { margin-bottom: 0; }

  .pending {
    margin-top: var(--s-7); padding: var(--s-5);
    border: 1px solid #d9b441; background: #fdf8e8;
  }
  .pending h2 { font-size: var(--t-sm); margin: 0 0 var(--s-3); }
  .pending ul { margin: 0; padding-left: 1.2em; display: grid; gap: var(--s-2); }
  .pending li { font-size: var(--t-sm); line-height: 1.6; color: var(--ink-muted); }
</style>
