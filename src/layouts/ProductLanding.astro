---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StickyCta from '../components/StickyCta.astro';
import Hero from '../components/blocks/Hero.astro';
import Offer from '../components/blocks/Offer.astro';
import Problem from '../components/blocks/Problem.astro';
import Cards from '../components/blocks/Cards.astro';
import Ingredients from '../components/blocks/Ingredients.astro';
import Steps from '../components/blocks/Steps.astro';
import Gallery from '../components/blocks/Gallery.astro';
import Testimonials from '../components/blocks/Testimonials.astro';
import Order from '../components/blocks/Order.astro';
import Faq from '../components/blocks/Faq.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { productGraph } from '../lib/schema';
import { resolveAssetUrl } from '../lib/images';
import { FLAGSHIP, productPath } from '../lib/routes';
import { assertTranslated, localePath, type Locale } from '../i18n/ui';

interface Props {
  product: any;
  brand: any;
  locale: Locale;
  canonical: string;
  alternates?: { locale: Locale; url: string }[];
}

const { product: p, brand: b, locale, canonical, alternates = [] } = Astro.props;
const site = Astro.site?.origin ?? 'https://mochatrinam.com';

// Không xuất bản một ngôn ngữ chưa dịch xong phần giao diện.
assertTranslated(locale);

const faqBlock = p.blocks.find((x: any) => x.type === 'faq');

// Sản phẩm chủ lực nằm ở gốc nên không có đường dẫn phân cấp để hiển thị.
const breadcrumb = p.slug === FLAGSHIP ? undefined : [
  { name: b.tradingName, url: new URL(localePath(locale, '/'), site).href },
  { name: p.shortName ?? p.name, url: new URL(productPath(p.slug, locale), site).href },
];

// og:image và ảnh trong schema phải là URL sau khi build, không phải đường dẫn nguồn
const heroBlock = p.blocks.find((x: any) => x.type === 'hero');
const ogImage = await resolveAssetUrl(p.seo.ogImage ?? heroBlock?.image?.src, site, 1200);
const logoUrl = await resolveAssetUrl(b.logo, site, 512);

const jsonLd = productGraph({
  product: p, brand: b, site, url: canonical, locale, faq: faqBlock?.items, breadcrumb,
  imageUrls: ogImage ? [ogImage] : [],
  logoUrl,
});

// Nền xen kẽ giữa các khối dạng thẻ, tính sẵn theo thứ tự xuất hiện
// để hai khối liền nhau không dính vào nhau.
const surfaceFor = new Map<number, 'bone' | 'paper'>();
p.blocks.forEach((block: any, i: number) => {
  if (block.type === 'cards') surfaceFor.set(i, surfaceFor.size % 2 === 0 ? 'bone' : 'paper');
});
---
<BaseLayout
  locale={locale}
  title={p.seo.title}
  description={p.seo.description}
  canonical={canonical}
  ogImage={ogImage}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <SiteHeader brand={b} locale={locale} alternates={alternates} />
  {breadcrumb && <Breadcrumb items={breadcrumb} />}

  <main id="main">
    {p.blocks.map((block: any, i: number) => {
      switch (block.type) {
        case 'hero':         return <Hero data={block} locale={locale} />;
        case 'offer':        return <Offer data={block} product={p} locale={locale} />;
        case 'problem':      return <Problem data={block} id={block.id} />;
        case 'cards':        return <Cards data={block} id={block.id} surface={surfaceFor.get(i)} />;
        case 'ingredients':  return <Ingredients data={block} id={block.id} locale={locale} />;
        case 'steps':        return <Steps data={block} id={block.id} />;
        case 'gallery':      return <Gallery data={block} id={block.id ?? 'hieu-qua'} locale={locale} />;
        case 'testimonials': return <Testimonials data={block} id={block.id} locale={locale} />;
        case 'order':        return <Order data={block} product={p} brand={b} locale={locale} />;
        case 'faq':          return <Faq data={block} id={block.id} />;
        default:             return null;
      }
    })}
  </main>

  <SiteFooter brand={b} product={p} locale={locale} />
  <StickyCta brand={b} locale={locale} />
</BaseLayout>
