---
import { getCollection } from 'astro:content';
import { DEFAULT_ANCHOR } from '../lib/block-anchors';
import { resolveRhythm } from '../lib/narrative';
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StickyCta from '../components/StickyCta.astro';
import PromoPopup from '../components/PromoPopup.astro';
import { engagementOf } from '../lib/engagement';
import Gallery from '../components/blocks/Gallery.astro';
import Testimonials from '../components/blocks/Testimonials.astro';
import Order from '../components/blocks/Order.astro';
import Faq from '../components/blocks/Faq.astro';
import Feature from '../components/blocks/Feature.astro';
import Documents from '../components/blocks/Documents.astro';
import RelatedProducts from '../components/blocks/RelatedProducts.astro';
import Analytics from '../components/Analytics.astro';
import FHero from '../components/flagship/FHero.astro';
import FProblem from '../components/flagship/FProblem.astro';
import FCards from '../components/flagship/FCards.astro';
import FTimeline from '../components/flagship/FTimeline.astro';
import FIngredients from '../components/flagship/FIngredients.astro';
import FSteps from '../components/flagship/FSteps.astro';
import FRoutine from '../components/flagship/FRoutine.astro';
import FOffer from '../components/flagship/FOffer.astro';
import FSkin from '../components/flagship/FSkin.astro';
import FCompare from '../components/flagship/FCompare.astro';
import FDocuments from '../components/flagship/FDocuments.astro';
import FConditions from '../components/flagship/FConditions.astro';
import FInfographic from '../components/flagship/FInfographic.astro';
import FVoices from '../components/flagship/FVoices.astro';
import FPromo from '../components/flagship/FPromo.astro';
import FFacts from '../components/flagship/FFacts.astro';
import ComboGrid from '../components/ComboGrid.astro';
import { packsFor, promoNow, promoWarnings, vnLastDay } from '../lib/promotions';
import { voicesFor, isDemoBuild } from '../lib/testimonials';
import { assertNotificationMatches } from '../lib/documents';
import Breadcrumb from '../components/Breadcrumb.astro';
import { expandProductTokens } from '../lib/money-text';
import { productGraph } from '../lib/schema';
import { resolveAssetUrl, resolveAssetImage } from '../lib/images';
import Section from '../components/Section.astro';
import { articlePath, comboIndexPath, homePath, linePath, productPath } from '../lib/routes';
import { assertTranslated, localePath, t, type Locale } from '../i18n/ui';

interface Props {
  product: any;
  brand: any;
  locale: Locale;
  canonical: string;
  alternates?: { locale: Locale; url: string }[];
  nav?: { label: string; href: string }[];
  policies?: { label: string; href: string }[];
  pages?: { label: string; href: string }[];
  /** Bài tư vấn liên quan — xem `relatedArticles` trong schema sản phẩm. */
  articles?: any[];
  /** Tra cứu thẻ sản phẩm theo slug, cho khối `relatedProducts`. */
  productCards?: Map<string, any>;
  /** Giấy tờ áp dụng cho sản phẩm này — xem `docsFor` trong src/lib/documents.ts. */
  documents?: any[];
  /** Thẻ các combo có chứa sản phẩm này (đã tính giá) — in ngay trước biểu mẫu đặt hàng. */
  combos?: any[];
}

const { product: raw, brand: b, locale, canonical, alternates = [], nav = [], policies = [], pages = [], articles = [], productCards = new Map(), documents = [], combos = [] } = Astro.props;
assertNotificationMatches(documents, raw);

/* Tổ chức công bố (in ở footer) là pháp nhân đưa SẢN PHẨM ra thị trường — không phải
   người bán. Site do đại lý vận hành, và mỗi dòng (Mocha, Hairborn) có thể do một
   công ty khác công bố. Điều phải giữ: một sản phẩm khai cùng một tên ở mọi ngôn ngữ.
   Kiểm định lần 6: bản EN từng dịch tên pháp nhân thành "Mocha Vietnam Cosmeceuticals"
   — tên pháp nhân là dữ kiện pháp lý, không dịch. */
{
  const orgs = new Set((await getCollection('products'))
    .filter((e: any) => e.data.translationKey === raw.translationKey)
    .map((e: any) => e.data.compliance.declarant ?? e.data.compliance.declaringOrganization));
  if (orgs.size > 1) {
    throw new Error(
      `"${raw.translationKey}": các ngôn ngữ khai tổ chức công bố khác nhau (${[...orgs].join(' | ')}). ` +
      `Tên pháp nhân phải giống hệt nhau ở mọi ngôn ngữ.`
    );
  }
}

// Thay token tiền một lần cho toàn bộ dữ liệu, trước khi bất kỳ component nào
// nhìn thấy nó. Nhờ vậy giá chỉ tồn tại ở trường `price` và không thể lệch.
const p = expandProductTokens(raw, {
  price: raw.price, compareAtPrice: raw.compareAtPrice, currency: raw.currency,
}, locale);
const site = Astro.site?.origin ?? 'https://mochatrinam.com';

// Không xuất bản một ngôn ngữ chưa dịch xong phần giao diện.
assertTranslated(locale);

const faqBlock = p.blocks.find((x: any) => x.type === 'faq');

/* Đường dẫn phân cấp thật: trang chủ -> dòng sản phẩm -> sản phẩm.
   Bản trước bỏ hẳn breadcrumb cho sản phẩm ở gốc; nay không sản phẩm nào ở gốc
   nữa, và bậc giữa (dòng sản phẩm) chính là trang gánh truy vấn không mang tên
   thương hiệu — bỏ nó khỏi breadcrumb là cắt mất liên kết nội bộ quan trọng nhất. */
const lineEntry = p.line
  ? (await getCollection('lines')).find(
    (l: any) => l.data.slug === p.line && l.data.locale === locale && l.data.status === 'published')
  : undefined;
const breadcrumb = [
  { name: t(locale, 'nav.home'), url: new URL(homePath(locale), site).href },
  ...(lineEntry
    ? [{ name: lineEntry.data.heading, url: new URL(linePath(p.line, locale), site).href }]
    : []),
  { name: p.shortName ?? p.name, url: new URL(productPath(p.slug, locale), site).href },
];

// og:image và ảnh trong schema phải là URL sau khi build, không phải đường dẫn nguồn
const heroBlock = p.blocks.find((x: any) => x.type === 'hero');
const ogSrc = p.seo.ogImage ?? heroBlock?.image?.src;
const ogResolved = await resolveAssetImage(ogSrc, site, 1200);
const ogImage = ogResolved?.url;
const ogImageDims = {
  width: ogResolved?.width ?? 1200,
  height: ogResolved?.height ?? 630,
  // alt của ảnh hero chỉ dùng được khi og:image CHÍNH LÀ ảnh hero.
  alt: ogSrc === heroBlock?.image?.src ? (heroBlock?.image?.alt ?? p.name) : p.name,
};
const logoUrl = await resolveAssetUrl(b.logo, site, 512);

/* ---- Khuyến mãi đang chạy (collection `promotions`) --------------------------
   Gói khuyến mãi KHÔNG khai trong file sản phẩm: mỗi đợt một file, có giờ bắt đầu và
   kết thúc. Lúc build lấy các gói đang chạy ở "bây giờ" (PROMO_NOW để xem trước), và
   máy chủ tự build lại đúng lúc một đợt bắt đầu hoặc kết thúc (server/main.ts). */
const now = promoNow();
const sameLocale = await getCollection('products', ({ data: d }: any) => d.status === 'published' && d.locale === locale);
const prices = new Map(sameLocale.map((e: any) => [e.data.slug, { price: e.data.price, name: e.data.shortName ?? e.data.name }]));
const promoEntries = (await getCollection('promotions')).map((e: any) => ({ id: e.id, data: e.data }));
const promoPacks = packsFor(p.slug, locale, promoEntries, prices, now, isDemoBuild(import.meta.env));
const promoIds = [...new Set(promoPacks.map((x) => x.promoId))];
const promoTerms = [...new Set(promoEntries.filter((e) => promoIds.includes(e.id)).flatMap((e) => e.data.terms))];
for (const w of [...promoPacks.flatMap((x) => x.warnings),
  ...promoEntries.filter((e) => promoIds.includes(e.id)).flatMap((e) => promoWarnings(e.data).map((m) => `"${e.id}": ${m}`))]) {
  console.warn(`
⚠️  Khuyến mãi trên ${p.slug}/${locale}: ${w}`);
}
/* Biểu mẫu đặt hàng: gói khuyến mãi đứng trước các gói thường. Một gói được chọn sẵn. */
const promoRecommended = promoPacks.some((x) => x.recommended);
const orderProduct = promoPacks.length ? {
  ...p,
  variants: [
    ...promoPacks.map((x, i) => ({
      label: x.label,
      price: x.price,
      recommended: promoRecommended ? x.recommended && promoPacks.findIndex((y) => y.recommended) === i : i === 0,
      promo: { badge: x.badge, regular: x.regular > x.price ? x.regular : undefined },
    })),
    ...p.variants.map((v: any) => ({ ...v, recommended: false })),
  ],
} : p;
/* Giá bán ưu đãi của CHÍNH sản phẩm này (1 món, không quà) thì JSON-LD phát giá đó, kèm
   hạn = ngày kết thúc đợt. Gói combo / quà tặng là đề nghị khác, không thay giá sản phẩm. */
const unitSale = promoPacks.find((x) => x.unitSaleOf === p.slug);

/* ---- Phản hồi khách (collection `testimonials`) ------------------------------- */
const demo = isDemoBuild(import.meta.env);
const testimonialEntries = (await getCollection('testimonials')).map((e: any) => ({ id: e.id, data: e.data }));

const jsonLd = productGraph({
  product: p, brand: b, site, url: canonical, locale, faq: faqBlock?.items, breadcrumb,
  imageUrls: ogImage ? [ogImage] : [],
  logoUrl,
  sale: unitSale ? { price: unitSale.price, validUntil: vnLastDay(unitSale.endsAt) } : undefined,
});

/**
 * Nhịp thị giác của trang, tính theo VAI của khối và VỊ TRÍ của nó.
 *
 * Bản trước: bảng `ACT` ngay tại file này ánh xạ LOẠI khối sang bề mặt —
 * `ingredients` luôn paper, `steps` luôn mist. Nên mọi trang sản phẩm có cùng
 * một chuỗi màu nền bất kể chúng kể chuyện gì, và đo được: 10 trên 12 sản phẩm
 * đã xuất bản dùng ĐÚNG một chuỗi khối giống hệt nhau.
 *
 * Nay vai là DỮ LIỆU (`narrativeRole` trong file nội dung) và bảng tra chuyển
 * sang `src/lib/narrative.ts`. Hai hệ quả:
 *
 *  - cùng một component đóng được hai vai ở hai trang, và nhịp đi theo vai;
 *  - luật nhịp kiểm được bằng unit test, vì nó là một hàm thuần chứ không còn
 *    là một vòng lặp nằm giữa layout.
 *
 * `surface`/`space` khai trong JSON vẫn thắng.
 */
const rhythm = resolveRhythm(p.blocks as any[]);

/* Mọi trang sản phẩm dùng bản trình bày flagship (src/components/flagship/).
   Bản "standard" cũ đã gỡ 2026-09-30: không trang nào còn dùng, nhưng CSS của
   nó vẫn nằm trong bundle chặn render của MỌI trang — đo được LCP của 3 trang
   vượt 2,5s trên 4G mô phỏng. Khối không có bản riêng (đặt hàng, hỏi đáp,
   gallery, lời chứng, gợi ý) dùng component chung với nhịp tính theo vai. */
/** Khối flagship tự chọn nền, nên chỉ nhận vai + câu nối + CTA. */
const fx = (i: number, block: any) => ({
  role: rhythm.get(i)?.role,
  transition: block.transition,
  cta: block.cta,
});
/** Nhịp + vai + câu nối của khối thứ i, spread thẳng vào component. */
const r = (i: number, block: any) => ({
  ...(rhythm.get(i) ?? {}),
  transition: block.transition,
  cta: block.cta,
});
---
<BaseLayout siteName={b.tradingName}
  locale={locale}
  title={p.seo.title}
  description={p.seo.description}
  canonical={canonical}
  ogImage={ogImage}
  ogImageWidth={ogImageDims.width}
  ogImageHeight={ogImageDims.height}
  ogImageAlt={ogImageDims.alt}
  alternates={alternates}
  jsonLd={jsonLd}
  subject={{ slug: p.slug, name: p.shortName ?? p.name, kind: 'product' }}
>
  <SiteHeader brand={b} locale={locale} alternates={alternates} nav={nav} />
  <Breadcrumb items={breadcrumb} locale={locale} />

  <FSkin />
  <main id="main" class="fx-main">
    {p.blocks.map((block: any, i: number) => {
      switch (block.type) {
        case 'hero':         return (<>
          <FHero data={block} locale={locale} product={p} />
          {promoPacks.length > 0 && <FPromo packs={promoPacks} terms={promoTerms} currency={p.currency} locale={locale} />}
          <FFacts facts={block.facts ?? []} locale={locale} />
        </>);
        case 'conditions':   return <FConditions data={block} id={block.id ?? DEFAULT_ANCHOR[block.type]} locale={locale} {...fx(i, block)} />;
        case 'infographic':  return <FInfographic data={block} id={block.id ?? DEFAULT_ANCHOR[block.type]} locale={locale} {...fx(i, block)} />;
        case 'voices':       return <FVoices data={block} id={block.id ?? DEFAULT_ANCHOR[block.type]} locale={locale} {...fx(i, block)}
                               voices={voicesFor(p.slug, locale, testimonialEntries, demo, block.limit)} />;
        case 'offer':        return <FOffer data={block} product={p} locale={locale} />;
        case 'problem':      return <FProblem data={block} id={block.id ?? DEFAULT_ANCHOR[block.type]} locale={locale} {...fx(i, block)} />;
        case 'cards':        return <FCards data={block} id={block.id ?? DEFAULT_ANCHOR[block.type]} tone={block.items.some((x: any) => x.image) ? 'bone' : 'paper'} {...fx(i, block)} />;
        case 'ingredients':  return <FIngredients data={block} id={block.id ?? DEFAULT_ANCHOR[block.type]} locale={locale} {...fx(i, block)} />;
        case 'steps':        return <FSteps data={block} id={block.id ?? DEFAULT_ANCHOR[block.type]} locale={locale} {...fx(i, block)} />;
        case 'gallery':      return <Gallery data={block} id={block.id ?? DEFAULT_ANCHOR.gallery} locale={locale} />;
        case 'testimonials': return <Testimonials data={block} id={block.id ?? DEFAULT_ANCHOR[block.type]} locale={locale} />;
        case 'order':        return (<>
          {/* Mua theo bộ đứng NGAY trước biểu mẫu: đúng lúc khách đang cân nhắc mua bao nhiêu. */}
          {combos.length > 0 && (
            <Section id="combo-co-san-pham" surface="paper" eyebrow={t(locale, 'combo.nav')}
              heading={t(locale, 'combo.withProduct')} intro={t(locale, 'combo.withProductIntro')}>
              <ComboGrid cards={combos} locale={locale} source="product-combos" />
              <p class="combo-all"><a href={comboIndexPath(locale)} data-cta="product-combo-all">{t(locale, 'combo.all')} →</a></p>
            </Section>
          )}
          <Order data={block} product={orderProduct} brand={b} locale={locale} />
        </>);
        case 'feature':      return <Feature data={block} id={block.id} />;
        /* Khối chứng từ KHAI trong file sản phẩm (vị trí do người biên tập chọn,
           vai "proof" đọc được từ dữ liệu). Không có `items` thì giấy tờ tự gom
           từ collection `documents` theo `appliesTo`. */
        case 'documents':    return block.items
          ? <Documents data={block} id={block.id ?? DEFAULT_ANCHOR[block.type]} {...r(i, block)} />
          : <FDocuments docs={documents} locale={locale} id={block.id ?? DEFAULT_ANCHOR[block.type]}
              notificationNumber={p.compliance.productNotificationNumber}
              eyebrow={block.eyebrow} heading={block.heading} intro={block.intro} role={rhythm.get(i)?.role} cta={block.cta} />;
        case 'timeline':     return <FTimeline data={block} id={block.id ?? DEFAULT_ANCHOR[block.type]} {...fx(i, block)} />;
        case 'routine':      return <FRoutine data={block} id={block.id ?? DEFAULT_ANCHOR[block.type]} locale={locale} {...fx(i, block)} />;
        case 'faq':          return <Faq data={block} id={block.id ?? DEFAULT_ANCHOR[block.type]} {...r(i, block)} />;
        case 'compare':      return (
          <FCompare data={block} locale={locale} current={p.slug}
            id={block.id ?? DEFAULT_ANCHOR[block.type]} {...fx(i, block)}
            products={block.items.map((slug: string) => productCards.get(slug)).filter(Boolean)} />
        );
        case 'relatedProducts': return (
          <RelatedProducts data={block} locale={locale}
            id={block.id ?? DEFAULT_ANCHOR[block.type]} {...r(i, block)}
            products={block.items
              .filter((slug: string) => slug !== p.slug)   /* tự trỏ về mình là một ngõ cụt khác */
              .map((slug: string) => productCards.get(slug))
              .filter(Boolean)} />
        );
        default:             return null;
      }
    })}

    {articles.length > 0 && (
      <Section id="doc-them" surface="bone" heading={t(locale, 'product.relatedArticles')}>
        <ul class="reads">
          {articles.map((a: any) => (
            <li>
              <a href={articlePath(a.slug, locale)}>
                <span class="read-title">{a.title}</span>
                <span class="read-lead">{a.lead}</span>
              </a>
            </li>
          ))}
        </ul>
      </Section>
    )}
  </main>

  <SiteFooter brand={b} product={p} locale={locale} nav={nav} policies={policies} pages={pages} />
  <StickyCta brand={b} locale={locale} />
  {promoPacks.length > 0 && engagementOf(b).promoPopup && (
    <PromoPopup packs={promoPacks} currency={p.currency} locale={locale} delaySec={engagementOf(b).promoDelaySec}
      image={heroBlock?.image?.src ? { src: heroBlock.image.src, alt: heroBlock.image.alt ?? p.name } : undefined} />
  )}
  <Analytics
    locale={locale}
    value={p.price}
    currency={p.currency}
    itemId={p.sku}
    itemName={p.shortName ?? p.name}
  />
</BaseLayout>

<style>
  .combo-all { margin: var(--s-6) 0 0; }
  .combo-all a { font-weight: 600; color: var(--cobalt); display: inline-block; min-height: 24px; line-height: 24px; }
</style>
