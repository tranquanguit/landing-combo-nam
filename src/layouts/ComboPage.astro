---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StickyCta from '../components/StickyCta.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Analytics from '../components/Analytics.astro';
import Picture from '../components/Picture.astro';
import Section from '../components/Section.astro';
import ComboGrid from '../components/ComboGrid.astro';
import Order from '../components/blocks/Order.astro';
import FPromo from '../components/flagship/FPromo.astro';
import { money } from '../lib/format';
import { orderedSteps, waitAfterPeel } from '../lib/combos';
import { breadcrumbNode, organizationNode } from '../lib/schema';
import { resolveAssetImage, resolveAssetUrl } from '../lib/images';
import { comboIndexPath, comboPath, homePath, productPath } from '../lib/routes';
import { assertTranslated, htmlLang, t, type Locale } from '../i18n/ui';

/**
 * Trang một combo. Gọn có chủ đích: thành phần, cách dùng chi tiết, giấy tờ của từng
 * món đã nằm ở trang sản phẩm, và mỗi món ở đây là một liên kết sang đó. Chép lại nội
 * dung các món vào trang combo là tạo ra 30 bản sao sẽ lệch khỏi bản gốc sau lần sửa đầu.
 */
interface Props {
  combo: any;
  /** Giá đã tính: { regular, save, pct } — src/lib/combos.ts. */
  pricing: { regular: number; save: number; pct: number };
  image: { src: string; alt: string };
  /** Thẻ sản phẩm theo slug (ảnh, tên, giá, dòng giới thiệu). */
  productCards: Map<string, any>;
  related: any[];
  promoPacks: any[];
  promoTerms: string[];
  brand: any;
  locale: Locale;
  canonical: string;
  alternates?: { locale: Locale; url: string }[];
  nav?: any[];
  policies?: { label: string; href: string }[];
  pages?: { label: string; href: string }[];
}
const {
  combo: c, pricing, image, productCards, related, promoPacks, promoTerms,
  brand: b, locale, canonical, alternates = [], nav = [], policies = [], pages = [],
} = Astro.props;
assertTranslated(locale);
const site = Astro.site?.origin ?? 'https://mochatrinam.com';
const m = (n: number) => money(n, 'VND', locale);

const items = c.items.map((it: any) => ({ ...it, card: productCards.get(it.product) }));
const gifts = c.gifts.map((g: any) => ({ ...g, card: g.product ? productCards.get(g.product) : undefined }));
const steps = orderedSteps(c.items, locale).map((s) => ({ ...s, card: productCards.get(s.product) }));
const wait = waitAfterPeel(c.items).map((s) => productCards.get(s)?.shortName ?? productCards.get(s)?.name ?? s);
const groupLabel = t(locale, `combo.group.${c.group}` as any);

const breadcrumb = [
  { name: t(locale, 'nav.home'), url: new URL(homePath(locale), site).href },
  { name: t(locale, 'combo.nav'), url: new URL(comboIndexPath(locale), site).href },
  { name: c.shortName, url: new URL(comboPath(c.slug, locale), site).href },
];

/* Biểu mẫu: gói khuyến mãi (nếu có) trước, rồi chính combo, rồi lựa chọn tư vấn. */
const orderProduct = {
  slug: c.slug, currency: 'VND', price: c.price, compareAtPrice: pricing.regular,
  variants: [
    ...promoPacks.map((x: any, i: number) => ({
      label: x.label, price: x.price, recommended: i === 0,
      promo: { badge: x.badge, regular: x.regular > x.price ? x.regular : undefined },
    })),
    { label: c.name, price: c.price, recommended: promoPacks.length === 0, promo: { regular: pricing.regular } },
    { label: t(locale, 'combo.consult'), price: null, recommended: false },
  ],
};
const orderData = {
  eyebrow: t(locale, 'nav.order'),
  heading: t(locale, 'combo.orderHeading'),
  body: t(locale, 'combo.orderBody'),
  points: [t(locale, 'combo.point1'), t(locale, 'combo.point2'), t(locale, 'combo.point3')],
};

const og = await resolveAssetImage(image.src, site, 1200);
const relatedNodes = await Promise.all(items.filter((it: any) => it.card).map(async (it: any) => {
  const href = new URL(productPath(it.product, locale), site).href;
  const img = await resolveAssetImage(it.card.image, site, 800);
  return {
    '@type': 'Product', name: it.card.name, url: href,
    ...(img?.url ? { image: [img.url] } : {}),
    brand: { '@type': 'Brand', name: it.card.brandName ?? 'Mocha' },
    offers: { '@type': 'Offer', url: href, price: String(it.card.price), priceCurrency: 'VND',
      availability: 'https://schema.org/InStock', itemCondition: 'https://schema.org/NewCondition', seller: { '@id': `${site}/#organization` } },
  };
}));
const logoUrl = await resolveAssetUrl(b.logo, site, 512);
const brandNames = [...new Set(items.map((it: any) => it.card?.brandName ?? 'Mocha'))];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    organizationNode(b, site, locale, logoUrl),
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: c.seo.title,
      description: c.seo.description,
      inLanguage: htmlLang[locale],
      mainEntity: { '@id': `${canonical}#product` },
      publisher: { '@id': `${site}/#organization` },
    },
    {
      '@type': 'Product',
      '@id': `${canonical}#product`,
      name: c.name,
      description: c.purpose,
      sku: `COMBO-${c.slug.toUpperCase()}`,
      ...(og?.url ? { image: [og.url] } : {}),
      brand: { '@type': 'Brand', name: brandNames.join(' · ') },
      /* Mỗi món trong bộ là một sản phẩm có trang riêng: nối bằng isRelatedTo, không khai lại. */
      /* Mỗi món là một sản phẩm có trang và giá riêng. Google coi mọi Product lồng vào là một
         sản phẩm độc lập, nên mỗi món phải kèm Offer (giá lẻ) — thiếu là lỗi nghiêm trọng
         "Either offers, review, or aggregateRating should be specified". */
      isRelatedTo: relatedNodes,
      offers: {
        '@type': 'Offer',
        url: canonical,
        price: String(c.price),
        priceCurrency: 'VND',
        availability: 'https://schema.org/InStock',
        itemCondition: 'https://schema.org/NewCondition',
        seller: { '@id': `${site}/#organization` },
      },
    },
    breadcrumbNode(canonical, breadcrumb),
  ],
};
---
<BaseLayout
  siteName={b.tradingName}
  locale={locale}
  title={c.seo.title}
  description={c.seo.description}
  canonical={canonical}
  ogImage={og?.url}
  ogImageWidth={og?.width}
  ogImageHeight={og?.height}
  ogImageAlt={image.alt}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <SiteHeader brand={b} locale={locale} alternates={alternates} nav={nav} />
  <Breadcrumb items={breadcrumb} locale={locale} />

  <main id="main">
    <section class="c-hero" aria-labelledby="hero-title">
      <div class="wrap c-grid">
        {/* Ảnh bìa KHÔNG có gì đè lên: không nhãn %, không chip. Mọi con số nằm ở cột chữ. */}
        <div class="media">
          <Picture src={image.src} alt={image.alt} ratio="1/1" fit="contain"
            sizes="(min-width: 960px) 560px, 92vw" widths={[480, 720, 960, 1200]}
            loading="eager" fetchpriority="high" />
        </div>
        <div class="copy">
          <p class="eyebrow">{groupLabel}</p>
          <h1 id="hero-title">{c.name}</h1>
          <p class="lead">{c.purpose}</p>

          <div class="buy">
            <p class="price">
              <span class="now figure">{m(c.price)}</span>
              <s class="was figure"><span class="sr-only">{t(locale, 'combo.regular')} </span>{m(pricing.regular)}</s>
            </p>
            <p class="save">{t(locale, 'combo.savePct').replace('{pct}', String(pricing.pct)).replace('{save}', m(pricing.save))}</p>
            <div class="actions">
              <a class="go" href="#dat-hang" data-cta="combo-primary">{t(locale, 'combo.order')}<span aria-hidden="true">→</span></a>
              <a class="alt" href="#trong-combo" data-cta="combo-secondary">{t(locale, 'combo.seeItems')}</a>
            </div>
          </div>

          <ul class="inc" aria-label={t(locale, 'combo.itemsTitle')}>
            {items.map((it: any) => (
              <li><span class="q figure">{it.qty}×</span> <a href={productPath(it.product, locale)}>{it.card?.shortName ?? it.card?.name ?? it.product}</a></li>
            ))}
            {gifts.map((g: any) => (
              <li class="gift"><span class="q figure">+{g.qty}</span> {g.card ? <a href={productPath(g.product, locale)}>{g.card.shortName ?? g.card.name}</a> : g.name} <span class="tag">{t(locale, 'combo.gift')}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    {promoPacks.length > 0 && <FPromo packs={promoPacks} terms={promoTerms} currency="VND" locale={locale} />}

    <Section id="trong-combo" surface="paper" eyebrow={t(locale, 'combo.count').replace('{n}', String(items.reduce((s: number, it: any) => s + it.qty, 0)))}
      heading={t(locale, 'combo.itemsTitle')} intro={t(locale, 'combo.itemsIntro')}>
      <ul class="items">
        {items.map((it: any) => it.card && (
          <li>
            <a href={productPath(it.product, locale)} data-cta="combo-item">
              <span class="shot">
                <Picture src={it.card.image} alt={it.card.imageAlt ?? it.card.name} ratio="1/1" fit="contain"
                  sizes="(min-width: 960px) 220px, 44vw" widths={[220, 330, 440]} />
              </span>
              <span class="nm">{it.qty > 1 && <span class="qty figure">{it.qty}×</span>}{it.card.shortName ?? it.card.name}</span>
              {it.card.tagline && <span class="tl">{it.card.tagline}</span>}
              <span class="pr">{t(locale, 'combo.each')} <span class="figure">{m(it.card.price)}</span></span>
              <span class="more">{t(locale, 'combo.view')}</span>
            </a>
          </li>
        ))}
        {gifts.map((g: any) => (
          <li class="is-gift">
            {g.card ? (
              <a href={productPath(g.product, locale)} data-cta="combo-gift">
                <span class="shot">
                  <Picture src={g.card.image} alt={g.card.imageAlt ?? g.card.name} ratio="1/1" fit="contain"
                    sizes="(min-width: 960px) 220px, 44vw" widths={[220, 330, 440]} />
                </span>
                <span class="nm"><span class="tag">{t(locale, 'combo.gift')}</span> {g.card.shortName ?? g.card.name}</span>
                <span class="more">{t(locale, 'combo.view')}</span>
              </a>
            ) : (
              <div class="plain"><span class="nm"><span class="tag">{t(locale, 'combo.gift')}</span> {g.qty > 1 ? `${g.qty}× ` : ''}{g.name}</span></div>
            )}
          </li>
        ))}
      </ul>
    </Section>

    <Section id="cach-dung" surface="bone" heading={t(locale, 'combo.stepsTitle')} intro={t(locale, 'combo.stepsIntro')}>
      <ol class="steps">
        {steps.map((s, i) => (
          <li>
            <span class="n figure">{i + 1}</span>
            <span>
              <a href={productPath(s.product, locale)}>{s.card?.shortName ?? s.card?.name ?? s.product}</a>
              {s.hint && <span class="hint">{s.hint}</span>}
            </span>
          </li>
        ))}
      </ol>
      {wait.length > 0 && (
        <p class="note">
          <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="8.5" /><path d="M10 6v5M10 13.8v.1" /></svg>
          <span>{t(locale, 'combo.peelNote').replace('{list}', wait.join(', '))}</span>
        </p>
      )}
      {c.note && <p class="note"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="8.5" /><path d="M10 6v5M10 13.8v.1" /></svg><span>{c.note}</span></p>}
    </Section>

    <Order data={orderData} product={orderProduct} brand={b} locale={locale} />

    {related.length > 0 && (
      <Section id="combo-khac" surface="paper" heading={t(locale, 'combo.related')}>
        <ComboGrid cards={related} locale={locale} source="combo-related" />
        <p class="all"><a href={comboIndexPath(locale)} data-cta="combo-all">{t(locale, 'combo.all')} →</a></p>
      </Section>
    )}
  </main>

  <SiteFooter brand={b} locale={locale} nav={nav} policies={policies} pages={pages} />
  <StickyCta brand={b} locale={locale} />
  <Analytics locale={locale} value={c.price} currency="VND" itemId={`COMBO-${c.slug.toUpperCase()}`} itemName={c.shortName} />
</BaseLayout>

<style>
  .c-hero {
    background: linear-gradient(180deg, var(--stage-a) 0%, var(--paper) 78%);
    padding-block: clamp(20px, 3vw, 40px) clamp(40px, 5vw, 72px);
  }
  .c-grid { display: grid; gap: clamp(24px, 4vw, 56px); align-items: center; }
  @media (min-width: 900px) { .c-grid { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); } }
  .media {
    background: #fff; border-radius: 24px; overflow: hidden;
    box-shadow: 0 0 0 1px rgba(26, 29, 82, .06), 0 30px 60px -40px rgba(26, 29, 82, .35);
  }
  .media :global(img) { display: block; width: 100%; height: auto; }
  h1 { margin: var(--s-2) 0 var(--s-4); font-size: clamp(1.75rem, 3.4vw, 2.6rem); line-height: 1.15; letter-spacing: -0.02em; color: var(--ink-navy); }
  .copy .lead { margin: 0 0 var(--s-5); max-width: 52ch; }
  .buy {
    display: grid; gap: var(--s-3); padding: var(--s-5);
    background: rgba(255, 255, 255, .92); border: 1px solid rgba(26, 29, 82, .08); border-radius: 20px;
    box-shadow: 0 30px 60px -36px rgba(26, 29, 82, .3); max-width: 34rem;
  }
  .price { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--s-2) var(--s-4); margin: 0; }
  .now { font-size: clamp(2rem, 3.6vw, 2.7rem); font-weight: 600; line-height: 1; color: var(--ink-navy); letter-spacing: -0.02em; }
  .was { color: var(--slate); font-size: var(--t-md); }
  .save { margin: 0; color: var(--verify); font-weight: 600; font-size: var(--t-sm); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--s-3); align-items: center; margin-top: var(--s-2); }
  .go {
    flex: 1 1 auto; display: inline-flex; align-items: center; justify-content: center; gap: var(--s-3);
    min-height: 56px; padding: 0 30px; border-radius: 999px;
    background: var(--ink-navy); color: #fff; font-weight: 600; text-decoration: none;
    box-shadow: 0 14px 30px -12px rgba(26, 29, 82, .55);
  }
  .go:hover { background: var(--cobalt); color: #fff; }
  .alt { display: inline-flex; align-items: center; min-height: 48px; padding: 0 6px; font-weight: 600; font-size: var(--t-sm); color: var(--ink-navy); text-underline-offset: 5px; }
  .inc { list-style: none; padding: 0; margin: var(--s-5) 0 0; display: grid; gap: var(--s-2); font-size: var(--t-sm); color: var(--ink-muted); }
  .inc a { color: var(--ink-navy); font-weight: 600; text-decoration: none; display: inline-block; min-height: 24px; line-height: 24px; }
  .inc a:hover { color: var(--cobalt); text-decoration: underline; }
  .q { display: inline-block; min-width: 2.2em; color: var(--cobalt); font-weight: 600; }
  .tag { display: inline-block; padding: 1px 8px; border-radius: 999px; background: #e7f3ee; color: var(--verify); font-size: var(--t-xs); font-weight: 600; }

  .items { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--s-5); grid-template-columns: repeat(auto-fill, minmax(min(100%, 190px), 1fr)); }
  .items a, .items .plain { display: grid; gap: var(--s-2); align-content: start; height: 100%; text-decoration: none; color: inherit; }
  .items .shot { display: block; background: #fff; border: 1px solid var(--line); border-radius: 14px; overflow: hidden; margin-bottom: var(--s-1); }
  .items .shot :global(img) { display: block; width: 100%; transition: transform 620ms var(--ease-out); }
  @media (hover: hover) { .items a:hover .shot :global(img) { transform: scale(1.035); } .items a:hover .nm { color: var(--cobalt); } }
  .nm { font-weight: 600; color: var(--ink-navy); line-height: 1.3; }
  .qty { color: var(--cobalt); margin-right: 6px; }
  .tl { font-size: var(--t-sm); color: var(--slate); line-height: 1.5; }
  .pr { font-size: var(--t-sm); color: var(--ink-muted); }
  .more { font-size: var(--t-xs); color: var(--cobalt); letter-spacing: .08em; text-transform: uppercase; margin-top: auto; }
  .is-gift .plain { padding: var(--s-4); border: 1px dashed var(--line-strong); border-radius: 14px; }

  .steps { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--s-3); max-width: 46rem; counter-reset: s; }
  .steps li { display: flex; gap: var(--s-4); align-items: flex-start; padding: var(--s-3) var(--s-4); background: #fff; border: 1px solid var(--line); border-radius: 14px; }
  .steps .n { flex: 0 0 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: var(--ink-navy); color: #fff; font-weight: 600; }
  .steps a { font-weight: 600; color: var(--ink-navy); text-decoration: none; display: inline-block; min-height: 24px; line-height: 24px; }
  .steps a:hover { color: var(--cobalt); text-decoration: underline; }
  .hint { display: block; font-size: var(--t-sm); color: var(--ink-muted); }
  .note { display: flex; gap: 10px; align-items: flex-start; margin: var(--s-5) 0 0; max-width: 46rem; padding: var(--s-4); border-radius: 14px; background: var(--amber-note); border: 1px solid #ecd9a4; color: var(--amber-ink); font-size: var(--t-sm); line-height: 1.55; }
  .note svg { flex: 0 0 18px; width: 18px; height: 18px; margin-top: 2px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; }
  .all { margin: var(--s-6) 0 0; }
  .all a { font-weight: 600; color: var(--cobalt); display: inline-block; min-height: 24px; line-height: 24px; }
</style>
