# Chép thành .env trên máy chủ rồi điền. KHÔNG commit file .env.
#   openssl rand -base64 36   -> dùng để sinh các chuỗi bí mật bên dưới

POSTGRES_PASSWORD=
# Token cho API /api/admin/orders (xuất CSV, tự động hoá). >= 24 ký tự.
ADMIN_TOKEN=
# Muối băm IP để chống spam đơn hàng (không lưu IP thô).
IP_SALT=

# Tài khoản quản trị đầu tiên — chỉ dùng khi CSDL CHƯA có tài khoản nào.
# Đăng nhập xong thì xoá mật khẩu khỏi đây và đổi mật khẩu trong Tài khoản (/admin/users).
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=

PUBLIC_SITE_URL=https://mochatrinam.com
SITE_DOMAIN=mochatrinam.com
# Trang quản trị ở tên miền con riêng (cần bản ghi DNS A trỏ về máy chủ, như tên miền chính).
# Website chạy script GTM/Facebook/TikTok; tách origin thì các script đó không chạm được /admin.
ADMIN_HOST=admin.mochatrinam.com
APP_PORT=8080

# Đo lường quảng cáo (trống = không gắn). Khách phải bấm đồng ý trước khi mã chạy.
#   GA4: G-XXXXXXXXXX (Google Analytics → Quản trị → Luồng dữ liệu)
#   Meta Pixel: dãy số (Events Manager) · TikTok Pixel: mã trong TikTok Ads → Events
# Đổi giá trị thì chạy lại: docker compose --profile https up -d --build
PUBLIC_GA4_ID=
PUBLIC_META_PIXEL_ID=
PUBLIC_TIKTOK_PIXEL_ID=
# 0 chỉ khi chạy thử bằng http (không có HTTPS) — cookie đăng nhập mới gửi được.
COOKIE_SECURE=1
# 1: mỗi lần container khởi động thì build lại site từ nội dung trong Postgres.
PUBLISH_ON_BOOT=1

# Chat — xem docs/chat-n8n.md. Đây chỉ là GIÁ TRỊ KHỞI ĐẦU: cấu hình lưu ở
# /admin/settings/chat được ưu tiên. Có thể để trống hết và đặt trên trang quản trị.
# Webhook "Production URL" của workflow n8n (POST, Respond to Webhook).
N8N_WEBHOOK_URL=
# Khoá chung: gửi ở header X-Mocha-Token (dùng làm Header Auth trong n8n) và ký HMAC
# ở X-Mocha-Signature. Sinh: openssl rand -hex 32
N8N_SHARED_SECRET=
N8N_TIMEOUT_MS=25000
# rules | n8n | off. Trống = n8n nếu có N8N_WEBHOOK_URL, ngược lại rules (kịch bản tư vấn).
CHAT_MODE=
# Giữ chữ hội thoại (ngày) — dữ liệu cá nhân, Nghị định 13/2023.
CHAT_RETENTION_DAYS=90
# Giữ số liệu phiên (chỉ số đếm, không chữ) để phân tích theo mùa.
CHAT_SESSION_RETENTION_DAYS=400
