# Chép thành .env trên máy chủ rồi điền. KHÔNG commit file .env.
#   openssl rand -base64 36   -> dùng để sinh các chuỗi bí mật bên dưới

POSTGRES_PASSWORD=
# Token cho API /api/admin/orders (xuất CSV, tự động hoá). >= 24 ký tự.
ADMIN_TOKEN=
# Muối băm IP để chống spam đơn hàng (không lưu IP thô).
IP_SALT=

# Tài khoản quản trị đầu tiên — chỉ dùng khi CSDL CHƯA có tài khoản nào.
# Đăng nhập xong thì xoá mật khẩu khỏi đây và đổi mật khẩu trong /admin/users.
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=

PUBLIC_SITE_URL=https://mochatrinam.com
SITE_DOMAIN=mochatrinam.com
APP_PORT=8080
# 0 chỉ khi chạy thử bằng http (không có HTTPS) — cookie đăng nhập mới gửi được.
COOKIE_SECURE=1
# 1: mỗi lần container khởi động thì build lại site từ nội dung trong Postgres.
PUBLISH_ON_BOOT=1
