# CHỈ dùng cho `npm run verify:docker` — dựng một bản triển khai tạm (project
# "mocha-verify", volume riêng, xoá sau khi kiểm). KHÔNG phải bí mật thật.
POSTGRES_PASSWORD=verify-only-postgres
ADMIN_TOKEN=verify-only-admin-token-000000000
IP_SALT=verify-only-salt
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=verify-only-password
PUBLIC_SITE_URL=https://mochatrinam.com
APP_PORT=18080
COOKIE_SECURE=0
PUBLISH_ON_BOOT=1
CHAT_MOCK=1
